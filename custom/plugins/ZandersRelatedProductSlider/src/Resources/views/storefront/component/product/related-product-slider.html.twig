{#
    Zanders Related Product Slider Component
    ==========================================================================
    Plugin: ZandersRelatedProductSlider
    Renders an interactive product slider on Product Detail Pages and CMS blocks.
#}

{% set ext = page.extensions.zandersRelatedProducts ?? null %}
{% set sliderProducts = products ?? (ext ? ext.products : []) %}
{% set sliderTitle = title ?? (ext ? ext.title : 'ALTERNATIVE PRODUCTS') %}
{% set sliderConfig = config ?? (ext ? ext.config : {
    showStockToggle: true,
    autoplay: false,
    autoplayTimeout: 4000,
    speed: 350
}) %}
{% set isCustomerLoggedIn = context.customer is not null and not context.customer.guest %}

{% if sliderProducts|length > 0 %}
    <section class="zanders-pdp-section zanders-pdp-alternatives zanders-related-product-slider-section"
             id="zandersRelatedProductSliderSection"
             data-related-product-slider="true"
             data-slider-options="{{ sliderConfig|json_encode|e('html_attr') }}">

        <div class="zanders-pdp-section-header">
            <h2 class="zanders-pdp-section-title">{{ sliderTitle }}</h2>

            <div class="zanders-pdp-section-controls">
                {% if sliderConfig.showStockToggle %}
                    <button type="button"
                            class="btn zanders-pdp-alt-stock-btn js-zanders-alt-stock-toggle"
                            aria-pressed="false">
                        HIDE OUT OF STOCK ITEMS
                    </button>
                {% endif %}

                <div class="zanders-pdp-carousel-nav">
                    <button type="button"
                            class="zanders-pdp-nav-arrow zanders-pdp-nav-arrow--prev js-zanders-alt-prev"
                            aria-label="Previous products">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <button type="button"
                            class="zanders-pdp-nav-arrow zanders-pdp-nav-arrow--next js-zanders-alt-next"
                            aria-label="Next products">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="zanders-pdp-alt-track js-zanders-alt-track">
            {% for alt in sliderProducts %}
                {% set altId = alt.id %}
                {% set altName = alt.translated.name %}
                {% set altSku = alt.productNumber %}
                {% set altUpc = alt.translated.customFields.upc ?: (alt.customFields.upc ?: alt.ean) %}
                {% set altStock = alt.availableStock is not null ? alt.availableStock : (alt.stock ?: 0) %}
                {% set altInStock = altStock > 0 %}
                {% set altUrl = seoUrl('frontend.detail.page', { productId: altId }) %}
                {% set altCover = alt.cover ? alt.cover.media : null %}
                {% set altPriceObj = alt.calculatedPrice %}
                {% set altPrice = altPriceObj ? altPriceObj.unitPrice : 0 %}
                {% set altListPrice = (altPriceObj and altPriceObj.listPrice) ? altPriceObj.listPrice.price : null %}
                {% set altMsrp = alt.translated.customFields.msrp ?: (alt.customFields.msrp ?: (altListPrice ?: altPrice)) %}

                <article class="zanders-alt-card js-zanders-alt-card" data-in-stock="{{ altInStock ? '1' : '0' }}" data-product-id="{{ altId }}">
                    <a href="{{ altUrl }}" class="zanders-alt-card-img-wrap" title="{{ altName }}">
                        {% if altCover and altCover.url %}
                            <img src="{{ altCover.url }}"
                                 alt="{{ altCover.translated.alt ?: altName }}"
                                 loading="lazy"
                                 class="zanders-alt-card-img">
                        {% else %}
                            <span class="zanders-alt-card-placeholder">
                                {% sw_icon 'placeholder' style { size: 'fluid' } %}
                            </span>
                        {% endif %}
                    </a>

                    <a href="{{ altUrl }}" class="zanders-alt-card-title" title="{{ altName }}">
                        {{ altName|u.truncate(65, '...') }}
                    </a>

                    <div class="zanders-alt-card-meta">
                        <div>Item Number: <strong>{{ altSku }}</strong></div>
                        {% if altUpc %}
                            <div>UPC: <strong>{{ altUpc }}</strong></div>
                        {% endif %}
                        <div>Available: <strong>{{ altStock }}</strong></div>
                    </div>

                    <div class="zanders-alt-card-prices">
                        <div class="zanders-alt-price-left">
                            {% if altListPrice and altListPrice > altPrice %}
                                <span class="zanders-alt-price-old">{{ altListPrice|currency }}</span>
                            {% endif %}
                            <span class="zanders-alt-price-val">{{ altPrice|currency }}</span>
                        </div>
                        <div class="zanders-alt-price-msrp">
                            MSRP : <span>{{ altMsrp|currency }}</span>
                        </div>
                    </div>

                    <div class="zanders-alt-card-footer">
                        <form action="{{ path('frontend.checkout.line-item.add') }}"
                              method="post"
                              class="zanders-alt-buy-form"
                              data-add-to-cart="true">
                            <input type="hidden" name="redirectTo" value="frontend.cart.offcanvas">
                            <input type="hidden" name="redirectParameters" data-redirect-parameters="true" value="{{ {productId: altId}|json_encode }}">
                            <input type="hidden" name="lineItems[{{ altId }}][id]" value="{{ altId }}">
                            <input type="hidden" name="lineItems[{{ altId }}][type]" value="product">
                            <input type="hidden" name="lineItems[{{ altId }}][referencedId]" value="{{ altId }}">
                            <input type="hidden" name="lineItems[{{ altId }}][quantity]" value="1">
                            <input type="hidden" name="lineItems[{{ altId }}][stackable]" value="1">
                            <input type="hidden" name="lineItems[{{ altId }}][removable]" value="1">
                            <input type="hidden" name="product-name" value="{{ altName }}">
                            <button type="submit" class="btn zanders-alt-add-btn">
                                ADD TO CART
                            </button>
                        </form>

                        <div class="zanders-alt-card-icons">
                            {% if config('core.cart.wishlistEnabled') and isCustomerLoggedIn %}
                                {% set altWishlistOpts = {
                                    productId: altId,
                                    router: {
                                        add: {
                                            afterLoginPath: path('frontend.wishlist.add.after.login', { productId: altId }),
                                            path: path('frontend.wishlist.product.add', { productId: altId }),
                                        },
                                        remove: {
                                            path: path('frontend.wishlist.product.remove', { productId: altId }),
                                        }
                                    },
                                    texts: {
                                        add: 'listing.addToWishlist'|trans|sw_sanitize,
                                        remove: 'listing.removeFromWishlist'|trans|sw_sanitize
                                    }
                                } %}
                                <button type="button"
                                        class="zanders-alt-icon-btn product-wishlist-btn product-wishlist-{{ altId }} product-wishlist-not-added"
                                        title="{{ 'listing.addToWishlist'|trans|sw_sanitize }}"
                                        data-add-to-wishlist="true"
                                        data-product-id="{{ altId }}"
                                        data-add-to-wishlist-options="{{ altWishlistOpts|json_encode }}">
                                    <span class="icon-wishlist-not-added">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="#999999" aria-hidden="true">
                                            <path d="M16.44 3.1C14.63 3.1 13.01 3.98 12 5.33 10.99 3.98 9.37 3.1 7.56 3.1 4.49 3.1 2 5.6 2 8.69c0 1.19.19 2.29.52 3.31 1.58 5 6.45 7.99 8.86 8.81.34.12.9.12 1.24 0 2.41-.82 7.28-3.81 8.86-8.81.33-1.02.52-2.12.52-3.31 0-3.09-2.49-5.59-5.56-5.59Z"/>
                                        </svg>
                                    </span>
                                    <span class="icon-wishlist-added">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="#991020" aria-hidden="true">
                                            <path d="M16.44 3.1C14.63 3.1 13.01 3.98 12 5.33 10.99 3.98 9.37 3.1 7.56 3.1 4.49 3.1 2 5.6 2 8.69c0 1.19.19 2.29.52 3.31 1.58 5 6.45 7.99 8.86 8.81.34.12.9.12 1.24 0 2.41-.82 7.28-3.81 8.86-8.81.33-1.02.52-2.12.52-3.31 0-3.09-2.49-5.59-5.56-5.59Z"/>
                                        </svg>
                                    </span>
                                </button>
                            {% endif %}

                            {% if config('FroshProductCompare.config.active') %}
                                {% set altCompareOpts = {
                                    productId: altId,
                                    showIconOnly: true,
                                    defaultText: 'froshProductCompare.general.addToCompare'|trans|sw_sanitize,
                                    addedText: 'froshProductCompare.general.removeFromCompare'|trans|sw_sanitize
                                } %}
                                <button type="button"
                                        class="zanders-alt-icon-btn product-compare-btn"
                                        data-add-to-compare-button="true"
                                        data-add-to-compare-button-options="{{ altCompareOpts|json_encode }}"
                                        title="{{ 'zanders.productCard.compare'|trans|default('Compare') }}">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                                        <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                                        <path d="M7 21h10" />
                                        <path d="M12 3v18" />
                                        <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
                                    </svg>
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>

    {#
        Interactive Slider Controller
    #}
    <script>
    (function() {
        function initRelatedProductSlider() {
            var sections = document.querySelectorAll('[data-related-product-slider="true"]');
            sections.forEach(function(section) {
                if (section.dataset.sliderInitialized) return;
                section.dataset.sliderInitialized = 'true';

                var track = section.querySelector('.js-zanders-alt-track');
                var prevBtn = section.querySelector('.js-zanders-alt-prev');
                var nextBtn = section.querySelector('.js-zanders-alt-next');
                var stockToggle = section.querySelector('.js-zanders-alt-stock-toggle');

                if (track && prevBtn && nextBtn) {
                    var scrollByCard = function(direction) {
                        var firstVisible = track.querySelector('.js-zanders-alt-card:not(.is-hidden)');
                        var step = firstVisible ? (firstVisible.getBoundingClientRect().width + 16) : 280;
                        track.scrollBy({ left: direction * step, behavior: 'smooth' });
                    };

                    prevBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        scrollByCard(-1);
                    });
                    nextBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        scrollByCard(1);
                    });
                }

                if (track && stockToggle) {
                    var hideOutOfStock = false;
                    stockToggle.addEventListener('click', function(e) {
                        e.preventDefault();
                        hideOutOfStock = !hideOutOfStock;
                        stockToggle.setAttribute('aria-pressed', hideOutOfStock ? 'true' : 'false');
                        stockToggle.classList.toggle('is-active', hideOutOfStock);
                        stockToggle.textContent = hideOutOfStock
                            ? 'SHOW OUT OF STOCK ITEMS'
                            : 'HIDE OUT OF STOCK ITEMS';

                        track.querySelectorAll('.js-zanders-alt-card').forEach(function(card) {
                            var inStock = card.getAttribute('data-in-stock') === '1';
                            card.classList.toggle('is-hidden', hideOutOfStock && !inStock);
                        });
                    });
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initRelatedProductSlider);
        } else {
            initRelatedProductSlider();
        }
    })();
    </script>
{% endif %}

