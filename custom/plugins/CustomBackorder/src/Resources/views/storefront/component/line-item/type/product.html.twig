{% sw_extends '@Storefront/storefront/component/line-item/type/product.html.twig' %}

{% block component_line_item_type_product_label %}
    {{ parent() }}

    {% set backorder = lineItem.payload.customBackorder ?? null %}
    {% if backorder and backorder.isBackordered %}
        <div class="custom-backorder-line-item-info mt-1" style="font-size: 12px; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 4px; padding: 4px 8px;">
            <strong>{{ backorder.message ?: ('customBackorder.badge'|trans|default('Available on backorder')) }}</strong>
            {% if backorder.quantityPhysical > 0 %}
                <span class="ms-2">{{ 'customBackorder.shipsNow'|trans|default('Ships now') }}: <strong>{{ backorder.quantityPhysical }}</strong></span>
            {% endif %}
            <span class="ms-2">{{ 'customBackorder.onBackorder'|trans|default('On backorder') }}: <strong>{{ backorder.quantityBackordered }}</strong></span>
            {% if backorder.expectedRestockAt %}
                <span class="ms-2 text-muted">{{ 'customBackorder.expectedRestock'|trans|default('Estimated restock') }}: {{ backorder.expectedRestockAt|date('d M Y') }}</span>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

