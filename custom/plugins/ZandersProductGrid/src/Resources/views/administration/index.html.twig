{% sw_extends '@Administration/administration/index.html.twig' %}

{% block administration_title %}
    <title>Zanders Administration | Sign In</title>
{% endblock %}

{% block administration_head_scripts %}
    {{ parent() }}

    <style nonce="{{ cspNonce }}">
        /* =============================================================================
           ZANDERS SPORTING GOODS - CLASSIC, CLEAN ADMIN LOGIN
           - Light, airy enterprise canvas (#f3f5f8) with subtle top crimson accent
           - Centered classic card (480px) with full 2:1 Zanders Hero Banner
           - Crisp white form body, subtle borders, classic typography (no clutter)
           - Smooth crimson focus states and refined primary Sign In button
           ============================================================================= */

        html, body {
            margin: 0 !important;
            padding: 0 !important;
            font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            -webkit-font-smoothing: antialiased !important;
            -moz-osx-font-smoothing: grayscale !important;
        }

        /* Initial Page Boot Loading Screen */
        .sw-page-loading-screen {
            background-color: #f3f5f8 !important;
        }
        .sw-page-loading-screen__circle {
            stroke: #991020 !important;
        }

        /* Classic Light Neutral Backdrop */
        .sw-login {
            min-height: 100vh !important;
            background:
                linear-gradient(180deg, #eef2f6 0%, #f8fafc 100%) !important;
            border-top: 4px solid #991020 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 32px 16px !important;
            box-sizing: border-box !important;

            /* Meteor Component Library Theme Overrides */
            --color-interaction-primary-default: #991020 !important;
            --color-interaction-primary-hover: #7c0d1a !important;
            --color-interaction-primary-active: #660a14 !important;
            --color-interaction-focus: rgba(153, 16, 32, 0.14) !important;
            --color-border-brand-selected: #991020 !important;
            --color-border-primary-default: #cbd5e1 !important;
        }

        /* Main Container */
        .sw-login .sw-login__container {
            position: relative !important;
            z-index: 2 !important;
            width: 480px !important;
            max-width: 100% !important;
            margin: auto !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            gap: 16px !important;
            animation: zanders-login-fade 0.35s ease-out backwards !important;
        }

        @keyframes zanders-login-fade {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Hide default Shopware logo (Zanders brand logo is in the hero banner) */
        .sw-login .sw-login__logo {
            display: none !important;
        }

        /* Classic White Card */
        .sw-login .sw-login__card {
            position: relative !important;
            display: flex !important;
            flex-direction: column !important;
            width: 100% !important;
            background: #ffffff !important;
            border-radius: 10px !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow:
                0 12px 32px -8px rgba(15, 23, 42, 0.09),
                0 2px 6px rgba(15, 23, 42, 0.04) !important;
            overflow: hidden !important;
            padding: 0 !important;
        }

        /* Top 2:1 Uncropped Zanders Banner */
        .sw-login .sw-login__card::before {
            content: '' !important;
            display: block !important;
            width: 100% !important;
            aspect-ratio: 2 / 1 !important;
            background-image: url('{{ asset('bundles/zandersproductgrid/static/img/zanders-admin-banner.jpg') }}') !important;
            background-size: cover !important;
            background-position: center center !important;
            background-repeat: no-repeat !important;
            border-bottom: 3px solid #991020 !important;
            flex-shrink: 0 !important;
        }

        /* Form Body */
        .sw-login .sw-login__card > * {
            width: 100% !important;
            padding: 28px 34px 32px !important;
            box-sizing: border-box !important;
            background: #ffffff !important;
        }

        .sw-login .sw-login__card form.sw-login-login,
        .sw-login .sw-login__card .sw-login-login {
            width: 100% !important;
            margin: 0 !important;
        }

        /* Classic Heading & Muted Subtitle */
        .sw-login .sw-login__heading {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 4px !important;
            margin-bottom: 22px !important;
            padding-bottom: 14px !important;
            border-bottom: 1px solid #f1f5f9 !important;
            text-align: left !important;
        }

        .sw-login .sw-login__content-headline {
            color: #0f172a !important;
            font-family: 'Poppins', sans-serif !important;
            font-size: 20px !important;
            font-weight: 600 !important;
            letter-spacing: -0.2px !important;
            margin: 0 !important;
            line-height: 1.3 !important;
        }

        .sw-login .sw-login__heading::after {
            content: 'Zanders Administration Portal';
            display: block !important;
            color: #64748b !important;
            font-family: 'Poppins', sans-serif !important;
            font-size: 13px !important;
            font-weight: 400 !important;
            margin: 0 !important;
        }

        /* Classic Clean Labels */
        .sw-login .mt-field__label,
        .sw-login .mt-field-label,
        .sw-login label {
            color: #334155 !important;
            font-family: 'Poppins', sans-serif !important;
            font-size: 13px !important;
            font-weight: 500 !important;
            margin-bottom: 6px !important;
        }

        /* Single-Border Classic Inputs */
        .sw-login .mt-field {
            margin-bottom: 16px !important;
        }

        .sw-login .mt-field__block {
            background-color: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            min-height: 42px !important;
            box-shadow: none !important;
            transition: border-color 0.18s ease, box-shadow 0.18s ease !important;
        }

        .sw-login .mt-field__block:hover {
            border-color: #94a3b8 !important;
        }

        .sw-login .mt-field__block:focus-within {
            border-color: #991020 !important;
            box-shadow: 0 0 0 3px rgba(153, 16, 32, 0.1) !important;
        }

        .sw-login .mt-field__block input {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
            color: #0f172a !important;
            font-family: 'Poppins', sans-serif !important;
            font-size: 14px !important;
        }

        /* Submit Button */
        .sw-login .sw-login__submit {
            margin-top: 20px !important;
            gap: 12px !important;
        }

        .sw-login button.sw-login__login-action,
        .sw-login .mt-button.sw-login__login-action,
        .sw-login .sw-login__submit button[type="submit"] {
            background: #991020 !important;
            border: 1px solid #991020 !important;
            border-radius: 6px !important;
            color: #ffffff !important;
            font-family: 'Poppins', sans-serif !important;
            font-size: 14px !important;
            font-weight: 600 !important;
            letter-spacing: 0.3px !important;
            height: 44px !important;
            width: 100% !important;
            box-shadow: 0 2px 6px rgba(153, 16, 32, 0.2) !important;
            cursor: pointer !important;
            transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease !important;
        }

        .sw-login button.sw-login__login-action:hover:not(:disabled),
        .sw-login .mt-button.sw-login__login-action:hover:not(:disabled),
        .sw-login .sw-login__submit button[type="submit"]:hover:not(:disabled) {
            background: #7c0d1a !important;
            border-color: #7c0d1a !important;
            box-shadow: 0 4px 12px rgba(153, 16, 32, 0.28) !important;
        }

        .sw-login button.sw-login__login-action:disabled,
        .sw-login .mt-button.sw-login__login-action:disabled {
            background: #e2e8f0 !important;
            border-color: #cbd5e1 !important;
            color: #94a3b8 !important;
            cursor: not-allowed !important;
            box-shadow: none !important;
        }

        /* Forgot Password & Back Links on Light Canvas */
        .sw-login .sw-login__forgot-password-action,
        .sw-login .sw-login__back-link {
            color: #475569 !important;
            font-family: 'Poppins', sans-serif !important;
            font-size: 13px !important;
            font-weight: 500 !important;
            text-decoration: none !important;
            transition: color 0.15s ease !important;
        }

        .sw-login .sw-login__forgot-password-action:hover,
        .sw-login .sw-login__back-link:hover {
            color: #991020 !important;
            text-decoration: underline !important;
        }

        /* Overlay Loader */
        .sw-login .sw-login__card > .mt-loader,
        .sw-login .sw-login__card > .sw-login__loader {
            position: absolute !important;
            inset: 0 !important;
            width: 100% !important;
            height: 100% !important;
            background: rgba(255, 255, 255, 0.88) !important;
            backdrop-filter: blur(3px) !important;
            z-index: 10 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        /* Mobile Adjustments */
        @media (max-width: 575.98px) {
            .sw-login {
                padding: 16px 12px !important;
            }

            .sw-login .sw-login__card > * {
                padding: 22px 20px 26px !important;
            }

            .sw-login .sw-login__content-headline {
                font-size: 18px !important;
            }
        }
    </style>
{% endblock %}
