{% block element_product_grid_items %}
    {% if grid.products and grid.products.count > 0 %}
        {% set colClass = 'col-6 col-md-4 col-lg-3' %}
        {% if grid.columns == 2 %}
            {% set colClass = 'col-12 col-sm-6' %}
        {% elseif grid.columns == 3 %}
            {% set colClass = 'col-6 col-md-4' %}
        {% elseif grid.columns == 6 %}
            {% set colClass = 'col-6 col-sm-4 col-md-3 col-lg-2' %}
        {% endif %}

        {% for product in grid.products %}
            {% block element_product_grid_item %}
                <div class="product-grid-col {{ colClass }} mb-4" data-product-id="{{ product.id }}">
                    {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                        product: product,
                        layout: grid.boxLayout,
                        displayMode: grid.displayMode
                    } %}
                </div>
            {% endblock %}
        {% endfor %}
    {% endif %}
{% endblock %}

