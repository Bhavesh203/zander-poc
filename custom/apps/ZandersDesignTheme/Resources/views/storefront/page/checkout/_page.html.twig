{% sw_extends '@Storefront/storefront/page/checkout/_page.html.twig' %}

{% block page_checkout %}
    <div class="checkout zanders-checkout-wrap">
        <div class="container zanders-checkout-container">
            {# Full-Width Progress Stepper across entire checkout #}
            {% block page_checkout_progress %}
                {% sw_include '@Storefront/storefront/component/checkout/checkout-steps.html.twig' with {
                    activeStep: 'address'
                } %}
            {% endblock %}

            {% block page_checkout_container %}
                {{ parent() }}
            {% endblock %}
        </div>
    </div>
{% endblock %}

