{#
    Zanders Account Sidebar & Header Dropdown Menu Override
    ==========================================================================
    Extends `@Storefront/storefront/page/account/sidebar.html.twig` to render
    a cohesive Zanders-branded account menu used in both:
    - Desktop left sidebar (`not headerWidget`): solid crimson red "MY ACCOUNT"
      header banner, 12 crisp uppercase navigation items with horizontal dividers,
      highlighted "PAYMENT PORTAL", and clean logout action.
    - Header account dropdown (`headerWidget`): compact crimson-accented menu
      with greeting and quick navigation.
#}
{% sw_extends '@Storefront/storefront/page/account/sidebar.html.twig' %}

{% block page_account_sidebar_inner %}
    {% set isGuest = context.customer and context.customer.guest %}

    {% if not headerWidget %}
        {# ========================================================================= #}
        {# 1. Desktop Account Sidebar (Exact Match to Reference Image)               #}
        {# ========================================================================= #}
        <div class="account-aside zanders-account-aside">
            <div class="card account-menu-inner">
                {% block page_account_sidebar_header %}
                    <div class="card-header account-aside-header zanders-account-aside-header">
                        <div class="account-aside-title">
                            {{ 'zanders.accountPage.sidebar.title'|trans|default('MY ACCOUNT') }}
                        </div>
                    </div>
                {% endblock %}

                {% block page_account_sidebar_menu %}
                    <nav class="list-group list-group-flush account-aside-list-group" aria-label="{{ 'zanders.accountPage.sidebar.title'|trans|default('MY ACCOUNT') }}">
                        {% block page_account_sidebar_menu_inner %}
                            {# 1. ACCOUNT DASHBOARD #}
                            {% block page_account_sidebar_link_home %}
                                <a href="{{ path('frontend.account.home.page') }}"
                                   title="{{ 'zanders.accountPage.sidebar.dashboard'|trans|default('ACCOUNT DASHBOARD') }}"
                                   class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.account.home.page') %} is-active{% endif %}"
                                   {% if activeRoute is same as('frontend.account.home.page') %} aria-current="page"{% endif %}>
                                    {{ 'zanders.accountPage.sidebar.dashboard'|trans|default('ACCOUNT DASHBOARD') }}
                                </a>
                            {% endblock %}

                            {# 2. ACCOUNT INFORMATION #}
                            {% block page_account_sidebar_link_profile %}
                                <a href="{{ path('frontend.account.profile.page') }}"
                                   title="{{ 'zanders.accountPage.sidebar.information'|trans|default('ACCOUNT INFORMATION') }}"
                                   class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.account.profile.page') %} is-active{% endif %}"
                                   {% if activeRoute is same as('frontend.account.profile.page') %} aria-current="page"{% endif %}>
                                    {{ 'zanders.accountPage.sidebar.information'|trans|default('ACCOUNT INFORMATION') }}
                                </a>
                            {% endblock %}

                            {# 3. ADDRESS BOOK #}
                            {% block page_account_sidebar_link_address %}
                                <a href="{{ path('frontend.account.address.page') }}"
                                   title="{{ 'zanders.accountPage.sidebar.addresses'|trans|default('ADDRESS BOOK') }}"
                                   class="list-group-item list-group-item-action account-aside-item{% if activeRoute starts with('frontend.account.address') %} is-active{% endif %}"
                                   {% if activeRoute starts with('frontend.account.address.page') %} aria-current="page"{% endif %}>
                                    {{ 'zanders.accountPage.sidebar.addresses'|trans|default('ADDRESS BOOK') }}
                                </a>
                            {% endblock %}

                            {# 4. MY OPEN ORDERS #}
                            {% block page_account_sidebar_link_orders %}
                                <a href="{{ path('frontend.account.order.page') }}"
                                   title="{{ 'zanders.accountPage.sidebar.orders'|trans|default('MY OPEN ORDERS') }}"
                                   class="list-group-item list-group-item-action account-aside-item{% if activeRoute starts with('frontend.account.order') or activeRoute is same as('frontend.account.edit-order.page') %} is-active{% endif %}"
                                   {% if activeRoute starts with('frontend.account.order') %} aria-current="page"{% endif %}>
                                    {{ 'zanders.accountPage.sidebar.orders'|trans|default('MY OPEN ORDERS') }}
                                </a>
                            {% endblock %}

                            {# 5. MY WISHLIST #}
                            {% if config('core.cart.wishlistEnabled') %}
                                <a href="{{ path('frontend.wishlist.page') }}"
                                   title="{{ 'zanders.accountPage.sidebar.wishlist'|trans|default('MY WISHLIST') }}"
                                   class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.wishlist.page') %} is-active{% endif %}"
                                   {% if activeRoute is same as('frontend.wishlist.page') %} aria-current="page"{% endif %}>
                                    {{ 'zanders.accountPage.sidebar.wishlist'|trans|default('MY WISHLIST') }}
                                </a>
                            {% endif %}

                            {# 6. NEWSLETTER SUBSCRIPTIONS #}
                            <a href="{{ path('frontend.account.newsletter.page') }}"
                               title="{{ 'zanders.accountPage.sidebar.newsletter'|trans|default('NEWSLETTER SUBSCRIPTIONS') }}"
                               class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.account.newsletter.page') %} is-active{% endif %}"
                               {% if activeRoute is same as('frontend.account.newsletter.page') %} aria-current="page"{% endif %}>
                                {{ 'zanders.accountPage.sidebar.newsletter'|trans|default('NEWSLETTER SUBSCRIPTIONS') }}
                            </a>

                            {# 7. MY INVOICES #}
                            <a href="{{ path('frontend.account.order.page') }}"
                               title="{{ 'zanders.accountPage.sidebar.invoices'|trans|default('MY INVOICES') }}"
                               class="list-group-item list-group-item-action account-aside-item">
                                {{ 'zanders.accountPage.sidebar.invoices'|trans|default('MY INVOICES') }}
                            </a>

                            {# 8. MY BACK ORDER LIST #}
                            <a href="{{ path('frontend.account.order.page') }}"
                               title="{{ 'zanders.accountPage.sidebar.backorders'|trans|default('MY BACK ORDER LIST') }}"
                               class="list-group-item list-group-item-action account-aside-item">
                                {{ 'zanders.accountPage.sidebar.backorders'|trans|default('MY BACK ORDER LIST') }}
                            </a>

                            {# 9. UPDATE FFL #}
                            <a href="{{ path('frontend.account.profile.page') }}"
                               title="{{ 'zanders.accountPage.sidebar.updateFfl'|trans|default('UPDATE FFL') }}"
                               class="list-group-item list-group-item-action account-aside-item">
                                {{ 'zanders.accountPage.sidebar.updateFfl'|trans|default('UPDATE FFL') }}
                            </a>

                            {# 10. UPLOAD RESALE CERTIFICATE #}
                            <a href="{{ path('frontend.account.profile.page') }}"
                               title="{{ 'zanders.accountPage.sidebar.resaleCert'|trans|default('UPLOAD RESALE CERTIFICATE') }}"
                               class="list-group-item list-group-item-action account-aside-item">
                                {{ 'zanders.accountPage.sidebar.resaleCert'|trans|default('UPLOAD RESALE CERTIFICATE') }}
                            </a>

                            {# 11. TAX CERTIFICATES #}
                            <a href="{{ path('frontend.account.profile.page') }}"
                               title="{{ 'zanders.accountPage.sidebar.taxCert'|trans|default('TAX CERTIFICATES') }}"
                               class="list-group-item list-group-item-action account-aside-item">
                                {{ 'zanders.accountPage.sidebar.taxCert'|trans|default('TAX CERTIFICATES') }}
                            </a>

                            {# 12. PAYMENT PORTAL (Red text highlighted) #}
                            <a href="{{ path('frontend.account.order.page') }}"
                               title="{{ 'zanders.accountPage.sidebar.paymentPortal'|trans|default('PAYMENT PORTAL') }}"
                               class="list-group-item list-group-item-action account-aside-item payment-portal-item">
                                {{ 'zanders.accountPage.sidebar.paymentPortal'|trans|default('PAYMENT PORTAL') }}
                            </a>
                        {% endblock %}
                    </nav>
                {% endblock %}

                {% block page_account_sidebar_footer %}
                    {% if context.customer and not isGuest %}
                        <div class="card-footer account-aside-footer">
                            {% block page_account_sidebar_logout %}
                                <a href="{{ path('frontend.account.logout.page') }}"
                                   class="account-aside-logout-link"
                                   title="{{ 'account.logout'|trans|default('LOGOUT') }}">
                                    {{ 'account.logout'|trans|default('LOGOUT')|upper }}
                                </a>
                            {% endblock %}
                        </div>
                    {% endif %}
                {% endblock %}
            </div>
        </div>

    {% else %}
        {# ========================================================================= #}
        {# 2. Header Dropdown Menu (Compact Header Dropdown)                         #}
        {# ========================================================================= #}
        <div class="header-account-menu zanders-header-account-menu">
            <div class="card account-menu-inner">
                {% if context.customer and not isGuest %}
                    <div class="card-header account-aside-header zanders-account-aside-header">
                        <div class="zanders-account-greeting">
                            {{ 'account.greetings'|trans|sw_sanitize }}
                            {{ context.customer.firstName }} {{ context.customer.lastName }}
                        </div>
                    </div>
                {% endif %}

                <nav class="list-group list-group-flush account-aside-list-group">
                    <a href="{{ path('frontend.account.home.page') }}"
                       class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.account.home.page') %} is-active{% endif %}">
                        {{ 'zanders.accountPage.sidebar.dashboard'|trans|default('ACCOUNT DASHBOARD') }}
                    </a>
                    <a href="{{ path('frontend.account.profile.page') }}"
                       class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.account.profile.page') %} is-active{% endif %}">
                        {{ 'zanders.accountPage.sidebar.information'|trans|default('ACCOUNT INFORMATION') }}
                    </a>
                    <a href="{{ path('frontend.account.address.page') }}"
                       class="list-group-item list-group-item-action account-aside-item{% if activeRoute starts with('frontend.account.address') %} is-active{% endif %}">
                        {{ 'zanders.accountPage.sidebar.addresses'|trans|default('ADDRESS BOOK') }}
                    </a>
                    <a href="{{ path('frontend.account.order.page') }}"
                       class="list-group-item list-group-item-action account-aside-item{% if activeRoute starts with('frontend.account.order') %} is-active{% endif %}">
                        {{ 'zanders.accountPage.sidebar.orders'|trans|default('MY OPEN ORDERS') }}
                    </a>
                    {% if config('core.cart.wishlistEnabled') %}
                        <a href="{{ path('frontend.wishlist.page') }}"
                           class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.wishlist.page') %} is-active{% endif %}">
                            {{ 'zanders.accountPage.sidebar.wishlist'|trans|default('MY WISHLIST') }}
                        </a>
                    {% endif %}
                </nav>

                {% if context.customer %}
                    <div class="card-footer account-aside-footer">
                        <a href="{{ path('frontend.account.logout.page') }}" class="account-aside-logout-link">
                            {{ 'account.logout'|trans|default('LOGOUT')|upper }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
