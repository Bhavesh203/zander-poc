{#
    Zanders Account Overview Address Cards Override
    ==========================================================================
    Extends `@Storefront/storefront/page/account/address.html.twig` to add
    clean "Manage Addresses" CTA buttons inside the Default Billing & Default
    Shipping cards on the Account Overview page.
#}
{% sw_extends '@Storefront/storefront/page/account/address.html.twig' %}

{% block page_account_overview_billing_address_actions_content %}
    <a href="{{ path('frontend.account.address.page') }}"
       class="btn zanders-account-outline-btn"
       title="{{ 'account.addressLink'|trans|striptags }}">
        {{ 'account.overviewChangeBilling'|trans|default('Change Billing Address')|sw_sanitize }}
    </a>
{% endblock %}

{% block page_account_overview_shipping_address_actions_content %}
    <a href="{{ path('frontend.account.address.page') }}"
       class="btn zanders-account-outline-btn"
       title="{{ 'account.addressLink'|trans|striptags }}">
        {{ 'account.overviewChangeShipping'|trans|default('Change Shipping Address')|sw_sanitize }}
    </a>
{% endblock %}

