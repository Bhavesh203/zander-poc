{#
    Zanders Compare Page Override
    ==========================================================================
    Extends FroshProductCompare's `page/compare.html.twig` to apply the Zanders
    visual hierarchy on both screen and print:
    - Print-only compact brand header (`.zanders-compare-print-header`) with
      the Zanders logo and crimson divider rule so printed sheets have clean
      branding without site header/navigation whitespace.
    - Screen page header (`.zanders-compare-header`) with crimson uppercase
      title and full-width bottom rule.
    - Action toolbar grouping Print / Clear All on the left and the
      "Show only differences" toggle switch on the right.
    - Preserves all FroshProductCompare JS hooks (`[data-compare-widget="true"]`,
      `.btn-printer`, `.btn-clear`, `.btn-show-differences`, `.compare-product-content`).
#}
{% sw_extends '@Storefront/storefront/page/compare.html.twig' %}

{% block frosh_product_compare_page_header %}
    {# Print-only compact Zanders letterhead (hidden on screen, shown in @media print) #}
    <div class="zanders-compare-print-header" aria-hidden="true">
        <div class="zanders-compare-print-logo">
            {% if theme_config('sw-logo-desktop') %}
                <img src="{{ theme_config('sw-logo-desktop')|sw_encode_url }}"
                     alt="{{ 'header.logoLink'|trans|striptags }}">
            {% endif %}
        </div>
        <div class="zanders-compare-print-meta">
            <div class="zanders-compare-print-title">
                {{ 'froshProductCompare.general.headline'|trans|sw_sanitize }}
            </div>
            <div class="zanders-compare-print-subtitle">
                Zanders Sporting Goods &bull; Product Specification Sheet
            </div>
        </div>
    </div>

    {# Screen page header #}
    <div class="zanders-compare-header d-print-none">
        <h1 class="product-compare-main-header zanders-compare-title">
            {{ 'froshProductCompare.general.headline'|trans|sw_sanitize }}
        </h1>
        <div class="zanders-compare-title-rule"></div>
    </div>
{% endblock %}

{% block frosh_product_compare_page_content_action %}
    {# Action toolbar: Print, Clear All, and Show Differences toggle #}
    <div class="zanders-compare-toolbar hide-on-print action-row d-print-none">
        <div class="zanders-compare-toolbar-actions">
            <button type="button"
                    class="btn zanders-compare-btn zanders-compare-btn--print btn-printer"
                    title="{{ 'froshProductCompare.action.print'|trans|sw_sanitize }}">
                <svg class="zanders-compare-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>{{ 'froshProductCompare.action.print'|trans|sw_sanitize }}</span>
            </button>

            <button type="button"
                    class="btn zanders-compare-btn zanders-compare-btn--clear btn-clear"
                    title="{{ 'froshProductCompare.action.clearAll'|trans|sw_sanitize }}">
                <svg class="zanders-compare-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
                <span>{{ 'froshProductCompare.action.clearAll'|trans|sw_sanitize }}</span>
            </button>
        </div>

        <div class="zanders-compare-toolbar-toggle">
            <div class="form-check form-switch zanders-compare-switch">
                <input class="form-check-input btn-show-differences"
                       type="checkbox"
                       role="switch"
                       id="flexShowDifferencesChecked">
                <label class="form-check-label" for="flexShowDifferencesChecked">
                    {{ 'froshProductCompare.action.showDifferences'|trans|sw_sanitize }}
                </label>
            </div>
        </div>
    </div>
{% endblock %}
