{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_body_inner %}
    {#
        Pre-paint Age Verification Check
        Runs synchronously before page content paints to avoid FOUC (flash of modal/scroll)
        by immediately tagging <html> with either `zanders-age-verified` or `age-verification-modal-open`.
    #}
    <script>
        (function() {
            try {
                var verified = localStorage.getItem('zanders_age_verified') === 'true';
                if (!verified) {
                    var cookies = document.cookie.split(';');
                    for (var i = 0; i < cookies.length; i++) {
                        if (cookies[i].trim().indexOf('zanders_age_verified=true') === 0) {
                            verified = true;
                            break;
                        }
                    }
                }
                if (verified) {
                    document.documentElement.classList.add('zanders-age-verified');
                } else {
                    document.documentElement.classList.add('age-verification-modal-open');
                }
            } catch (e) {}
        })();
    </script>

    {{ parent() }}

    {# Global overlays: product finder tabs/drawer, sticky mobile bottom bar & age verification gate (omitted on checkout pages) #}
    {% if not ('checkout' in app.request.attributes.get('_route')|default('')) %}
        {% sw_include '@Storefront/storefront/component/product-finder.html.twig' %}
        {% sw_include '@Storefront/storefront/layout/footer/mobile-bottom-bar.html.twig' %}
    {% endif %}
    {% sw_include '@Storefront/storefront/component/age-verification-modal.html.twig' %}
{% endblock %}

{% block base_body_script %}
    {{ parent() }}

    {#
        Global Storefront Client Script
        1. Customer-only Wishlist Manager (enforces login requirement, syncs localStorage + header badge + AJAX)
        2. Toast Notification Helper (floating top-right alert banners)
        3. Product Quick View Modal Launcher (fetches minimal product view via AJAX into Bootstrap modal)
    #}
    <script>
    (function() {
        {% set isCustomerLoggedIn = context.customer is not null and not context.customer.guest %}
        var isCustomerLoggedIn = {{ isCustomerLoggedIn ? 'true' : 'false' }};
        var loginUrl = {{ path('frontend.account.login.page')|json_encode|raw }};
        var msgAdded = {{ 'wishlist.itemAddedSuccess'|trans|json_encode|raw }};
        var msgRemoved = {{ 'wishlist.itemDeleteSuccess'|trans|json_encode|raw }};
        var msgLoginRequired = {{ 'zanders.wishlist.loginRequired'|trans|default('Please log in or register to add products to your wishlist.')|json_encode|raw }};

        /**
         * Returns the sales-channel-scoped localStorage key used by Shopware for wishlist items.
         * @returns {string}
         */
        function getWishlistStorageKey() {
            return 'wishlist-' + (window.salesChannelId || '');
        }

        // Security/UX: clear any leftover guest wishlist entries when not logged in
        if (!isCustomerLoggedIn) {
            try {
                localStorage.removeItem(getWishlistStorageKey());
            } catch (e) {}
        }

        /**
         * Reads the logged-in customer's wishlist product map from localStorage.
         * @returns {Object<string, string>} Map of productId => ISO timestamp
         */
        function getLocalWishlist() {
            if (!isCustomerLoggedIn) return {};
            try {
                var raw = localStorage.getItem(getWishlistStorageKey());
                return raw ? JSON.parse(raw) : {};
            } catch (e) {
                return {};
            }
        }

        /**
         * Persists the wishlist product map to localStorage (or clears key if empty).
         * @param {Object<string, string>} products
         */
        function saveLocalWishlist(products) {
            if (!isCustomerLoggedIn) return;
            try {
                if (!products || Object.keys(products).length === 0) {
                    localStorage.removeItem(getWishlistStorageKey());
                } else {
                    localStorage.setItem(getWishlistStorageKey(), JSON.stringify(products));
                }
            } catch (e) {}
        }

        /**
         * Updates all header wishlist count badges and the screen-reader live region.
         * @param {number} count Number of items in the customer's wishlist
         */
        function updateBadge(count) {
            var badges = document.querySelectorAll('#wishlist-basket, .header-wishlist-badge');
            badges.forEach(function(badge) {
                badge.innerHTML = (isCustomerLoggedIn && count > 0) ? count : '';
            });
            var liveArea = document.querySelector('#wishlist-basket-live-area');
            if (liveArea) {
                var tmpl = liveArea.getAttribute('data-wishlist-live-area-text') || 'You have %counter% wishlist items';
                liveArea.innerHTML = isCustomerLoggedIn ? ('<p>' + tmpl.replace('%counter%', count) + '</p>') : '';
            }
        }

        /**
         * Displays a floating auto-dismissing Bootstrap toast alert in `#zanders-toast-container`.
         * @param {string} msg Message text or HTML to display
         * @param {'success'|'info'|'warning'} [alertType='success'] Bootstrap alert style
         */
        function showWishlistNotification(msg, alertType) {
            alertType = alertType || 'success';

            // 1. Fixed floating toast container
            var toastContainer = document.getElementById('zanders-toast-container');
            if (!toastContainer) {
                toastContainer = document.createElement('div');
                toastContainer.id = 'zanders-toast-container';
                toastContainer.className = 'zanders-toast-container';
                document.body.appendChild(toastContainer);
            }

            var alertEl = document.createElement('div');
            alertEl.className = 'alert alert-' + alertType + ' alert-dismissible fade show d-flex align-items-center shadow zanders-wishlist-alert';
            alertEl.setAttribute('role', 'alert');
            alertEl.setAttribute('aria-live', 'polite');

            var iconHtml;
            if (alertType === 'warning') {
                iconHtml = '<span class="alert-icon me-2 flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span>';
            } else if (alertType === 'info') {
                iconHtml = '<span class="alert-icon me-2 flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg></span>';
            } else {
                iconHtml = '<span class="alert-icon me-2 flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></span>';
            }

            alertEl.innerHTML = iconHtml +
                '<div class="alert-content-container flex-grow-1">' + msg + '</div>' +
                '<button type="button" class="btn-close ms-2" aria-label="Close"></button>';

            var closeBtn = alertEl.querySelector('.btn-close');
            if (closeBtn) {
                closeBtn.addEventListener('click', function() {
                    alertEl.classList.remove('show');
                    setTimeout(function() { alertEl.remove(); }, 250);
                });
            }

            toastContainer.appendChild(alertEl);

            // Auto dismiss toast after 4s
            setTimeout(function() {
                if (alertEl.parentNode) {
                    alertEl.classList.remove('show');
                    setTimeout(function() { alertEl.remove(); }, 250);
                }
            }, 4000);
        }

        /**
         * Applies active/inactive wishlist CSS classes to a single wishlist button element.
         * @param {HTMLElement} btn
         * @param {boolean} isAdded
         */
        function syncButtonState(btn, isAdded) {
            btn.classList.toggle('product-wishlist-added', isAdded);
            btn.classList.toggle('is-wishlist', isAdded);
            btn.classList.toggle('product-wishlist-not-added', !isAdded);
            btn.classList.remove('product-wishlist-loading');
        }

        /**
         * Synchronizes every `.product-wishlist-btn` in the DOM and the header badge
         * against the current customer's stored wishlist state.
         */
        function syncAllButtons() {
            if (!isCustomerLoggedIn) {
                var buttons = document.querySelectorAll('.product-wishlist-btn');
                buttons.forEach(function(btn) {
                    syncButtonState(btn, false);
                });
                updateBadge(0);
                return;
            }

            var products = getLocalWishlist();
            var buttons = document.querySelectorAll('.product-wishlist-btn');
            buttons.forEach(function(btn) {
                var pid = btn.getAttribute('data-product-id');
                if (!pid) {
                    var cls = btn.className.match(/product-wishlist-([a-f0-9]{32})/);
                    if (cls) pid = cls[1];
                }
                if (pid) {
                    var isAdded = Boolean(products[pid]);
                    syncButtonState(btn, isAdded);
                }
            });
            updateBadge(Object.keys(products).length);
        }

        // Initial sync of all wishlist buttons on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', syncAllButtons);
        } else {
            syncAllButtons();
        }

        // Capture-phase click handler for all `.product-wishlist-btn` triggers:
        // - Guests: display warning toast and redirect to login page
        // - Logged-in customers: toggle item in localStorage, update UI/badge, and POST to Shopware router
        document.addEventListener('click', function(e) {
            var btn = e.target.closest('.product-wishlist-btn');
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            // Condition: Wishlist is only for logged-in customer!
            if (!isCustomerLoggedIn) {
                var currentUrl = window.location.pathname + window.location.search;
                var targetLoginUrl = loginUrl + '?redirectTo=' + encodeURIComponent(currentUrl);

                showWishlistNotification(
                    msgLoginRequired + '<div class="mt-2"><a href="' + targetLoginUrl + '" class="btn btn-sm text-white fw-bold text-uppercase" style="background-color: #8c1d2f; border-radius: 2px; padding: 4px 14px; font-size: 12px; text-decoration: none;">Log In Now</a></div>',
                    'warning'
                );

                setTimeout(function() {
                    window.location.href = targetLoginUrl;
                }, 1400);
                return;
            }

            var pid = btn.getAttribute('data-product-id');
            if (!pid) {
                var cls = btn.className.match(/product-wishlist-([a-f0-9]{32})/);
                if (cls) pid = cls[1];
            }
            if (!pid) return;

            var products = getLocalWishlist();
            var wasAdded = Boolean(products[pid]);
            var willBeAdded = !wasAdded;

            if (willBeAdded) {
                products[pid] = new Date().toISOString();
            } else {
                delete products[pid];
            }

            saveLocalWishlist(products);

            var matchingBtns = document.querySelectorAll('.product-wishlist-' + pid + ', [data-product-id="' + pid + '"].product-wishlist-btn');
            matchingBtns.forEach(function(b) {
                syncButtonState(b, willBeAdded);
            });

            var count = Object.keys(products).length;
            updateBadge(count);

            // Display Shopware notification
            showWishlistNotification(willBeAdded ? msgAdded : msgRemoved, willBeAdded ? 'success' : 'info');

            var optStr = btn.getAttribute('data-add-to-wishlist-options');
            var opt = optStr ? JSON.parse(optStr) : null;
            if (opt && opt.router) {
                var url = willBeAdded ? opt.router.add.path : opt.router.remove.path;
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json'
                    }
                }).catch(function() {});
            }

            try {
                var basket = document.querySelector('#wishlist-basket');
                if (basket && window.PluginManager) {
                    var storage = window.PluginManager.getPluginInstanceFromElement(basket, 'WishlistStorage');
                    if (storage && storage.$emitter) {
                        storage.$emitter.publish(willBeAdded ? 'Wishlist/onProductAdded' : 'Wishlist/onProductRemoved', {
                            products: products,
                            productId: pid
                        });
                    }
                }
            } catch (err) {}
        }, true);

        // Keep wishlist button states synchronized across multiple open browser tabs
        window.addEventListener('storage', function(e) {
            if (e.key === getWishlistStorageKey()) {
                syncAllButtons();
            }
        });

        /* =========================================================
           Quick View Modal Launcher & Dynamic Loader
           ========================================================= */
        var qvTitleText = {{ 'zanders.productCard.quickView'|trans|default('Quick View')|json_encode|raw }};

        /**
         * Returns the shared Quick View Bootstrap modal element, creating and appending it
         * to `document.body` on first use. Auto-closes when an Add-to-Cart form opens the offcanvas cart.
         * @returns {HTMLElement}
         */
        function getOrCreateQuickviewModal() {
            var modalEl = document.getElementById('zanders-quickview-modal');
            if (modalEl) return modalEl;

            modalEl = document.createElement('div');
            modalEl.id = 'zanders-quickview-modal';
            modalEl.className = 'modal fade quickview-modal';
            modalEl.setAttribute('tabindex', '-1');
            modalEl.setAttribute('aria-hidden', 'true');
            modalEl.innerHTML = 
                '<div class="modal-dialog modal-dialog-centered modal-lg">' +
                    '<div class="modal-content">' +
                        '<div class="modal-header">' +
                            '<span class="quickview-modal-header-badge">' + qvTitleText + '</span>' +
                            '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>' +
                        '</div>' +
                        '<div class="modal-body position-relative p-0">' +
                            '<div class="quickview-loading-spinner text-center py-5">' +
                                '<div class="spinner-border" role="status">' +
                                    '<span class="visually-hidden">Loading...</span>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            document.body.appendChild(modalEl);

            // Close on submit of add-to-cart when offcanvas opens
            modalEl.addEventListener('submit', function(ev) {
                var form = ev.target.closest('.quickview-buy-form');
                if (!form) return;
                var r = form.querySelector('input[name=redirectTo]');
                if (r && r.value === 'frontend.cart.offcanvas') {
                    setTimeout(function() {
                        var bs = window.bootstrap && window.bootstrap.Modal
                            ? window.bootstrap.Modal.getInstance(modalEl)
                            : null;
                        if (bs) bs.hide();
                    }, 400);
                }
            });

            return modalEl;
        }

        // Delegated click handler for `.product-quickview-btn`:
        // Opens the Quick View modal with a spinner, fetches the minimal product view via AJAX,
        // injects `.zanders-quickview-container`, and initializes Shopware JS plugins inside it.
        document.addEventListener('click', function(e) {
            var btn = e.target.closest('.product-quickview-btn');
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            var url = btn.getAttribute('data-url') || btn.getAttribute('href');
            if (!url) {
                var pid = btn.getAttribute('data-product-id');
                if (pid) {
                    url = '/quickview/' + pid;
                }
            }
            if (!url) return;

            var modalEl = getOrCreateQuickviewModal();
            var modalBody = modalEl.querySelector('.modal-body');
            modalBody.innerHTML = 
                '<div class="quickview-loading-spinner text-center py-5">' +
                    '<div class="spinner-border" role="status">' +
                        '<span class="visually-hidden">Loading...</span>' +
                    '</div>' +
                '</div>';

            var bsModal = window.bootstrap && window.bootstrap.Modal
                ? window.bootstrap.Modal.getOrCreateInstance(modalEl)
                : null;
            if (bsModal) {
                bsModal.show();
            } else {
                modalEl.classList.add('show');
                modalEl.style.display = 'block';
            }

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(function(res) {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.text();
            })
            .then(function(html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var container = doc.querySelector('.zanders-quickview-container');
                modalBody.innerHTML = container ? container.outerHTML : html;
                if (window.PluginManager) {
                    window.PluginManager.initializePluginsInParentElement(modalBody);
                }
                syncAllButtons();
            })
            .catch(function(err) {
                modalBody.innerHTML = '<div class="alert alert-danger m-3">Unable to load product preview. Please try again.</div>';
            });
        }, true);

        // Re-sync wishlist button states whenever new product cards are dynamically added (e.g. Load More / filters)
        var observer = new MutationObserver(function() {
            syncAllButtons();
        });
        var target = document.querySelector('main') || document.body;
        if (target) {
            observer.observe(target, { childList: true, subtree: true });
        }

        /* =========================================================
           Offcanvas Cart Smooth Transition & Layout Jump Prevention
           ========================================================= */
        var myCartTitle = {{ 'zanders.cart.myCart'|trans|default('My Cart')|json_encode|raw }};

        document.addEventListener('show.bs.offcanvas', function(e) {
            document.documentElement.classList.add('offcanvas-open');
            var offcanvasEl = e.target;
            if (offcanvasEl && offcanvasEl.classList.contains('cart-offcanvas')) {
                // Pre-inject header so the drawer layout is fully established
                // before the slide-in animation starts and before the AJAX payload arrives.
                if (!offcanvasEl.querySelector('.offcanvas-header')) {
                    var headerHtml = 
                        '<div class="offcanvas-header d-flex align-items-center justify-content-between border-bottom bg-white">' +
                            '<h4 class="offcanvas-cart-title m-0 fw-bold fs-5 text-dark">' + myCartTitle + '</h4>' +
                            '<button type="button" class="btn-close js-offcanvas-close text-reset m-0" data-bs-dismiss="offcanvas" aria-label="Close"></button>' +
                        '</div>';
                    offcanvasEl.insertAdjacentHTML('afterbegin', headerHtml);
                }
            }
        });

        document.addEventListener('hidden.bs.offcanvas', function() {
            if (!document.querySelector('.offcanvas.show, .offcanvas.showing')) {
                document.documentElement.classList.remove('offcanvas-open');
            }
        });
    })();
    </script>
{% endblock %}
