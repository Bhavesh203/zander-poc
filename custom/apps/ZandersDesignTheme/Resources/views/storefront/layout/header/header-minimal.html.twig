{#
    Zanders Checkout Minimal Header
    ==========================================================================
    Classic, clean, distraction-free header for checkout pages.
#}
{% sw_extends '@Storefront/storefront/layout/header/header-minimal.html.twig' %}

{% block layout_header_minimal_row %}
    <div class="row align-items-center zanders-checkout-header-row">
        {# 1. Zanders Brand Logo #}
        {% block layout_header_minimal_logo %}
            <div class="col-6 col-md-3 zanders-checkout-header-col-logo">
                <a href="{{ path('frontend.home.page') }}" class="zanders-checkout-logo-link" title="Zanders Sporting Goods">
                    {% if theme_config('sw-logo-desktop') %}
                        <img src="{{ theme_config('sw-logo-desktop')|sw_encode_url }}"
                             alt="Zanders Sporting Goods"
                             class="zanders-checkout-logo-img">
                    {% else %}
                        <img src="{{ asset('bundles/zandersdesigntheme/assets/img/zanders-logo.png') }}"
                             alt="Zanders Sporting Goods"
                             class="zanders-checkout-logo-img">
                    {% endif %}
                </a>
            </div>
        {% endblock %}

        {# 2. Subtle Trust Badge in Center #}
        <div class="col-12 col-md-6 d-none d-md-flex justify-content-center zanders-checkout-header-col-security">
            <div class="zanders-checkout-trust-badge">
                <svg class="zanders-checkout-lock-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span class="zanders-checkout-trust-title">SECURE CHECKOUT</span>
                <span class="zanders-checkout-trust-dot">&bull;</span>
                <span class="zanders-checkout-trust-sub">256-Bit SSL Encrypted</span>
            </div>
        </div>

        {# 3. Support & Back to Cart on Right #}
        <div class="col-6 col-md-3 text-end zanders-checkout-header-col-actions">
            {% set headerPhone = theme_config('zanders-header-phone') ?: '800.851.4373' %}
            <div class="zanders-checkout-support-wrap d-none d-lg-inline-flex">
                <span class="zanders-checkout-support-label">Need Help?</span>
                <a href="tel:{{ headerPhone|replace({'.': '', ' ': '', '-': ''}) }}" class="zanders-checkout-support-phone">
                    {{ headerPhone }}
                </a>
            </div>

            <a href="{{ path('frontend.checkout.cart.page') }}" class="btn zanders-checkout-back-cart-btn" title="Back to Shopping Cart">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back to Cart</span>
            </a>
        </div>
    </div>
{% endblock %}
