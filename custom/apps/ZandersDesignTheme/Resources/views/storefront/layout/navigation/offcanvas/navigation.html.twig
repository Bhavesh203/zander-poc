{% sw_extends '@Storefront/storefront/layout/navigation/offcanvas/navigation.html.twig' %}

{% block utilities_offcanvas_header %}
    <div class="offcanvas-header zanders-mobile-menu-header">
        <span class="zanders-mobile-menu-title">{{ 'general.menuLink'|trans|default('Menu')|sw_sanitize }}</span>
        <button class="btn offcanvas-close js-offcanvas-close"
                type="button"
                aria-label="{{ 'general.offcanvasCloseMenu'|trans|default('Close menu')|striptags }}">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12.5 3.5L3.5 12.5M3.5 3.5L12.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
{% endblock %}

{% block utilities_offcanvas_content %}
    {{ parent() }}

    {% set isCustomerLoggedIn = context.customer is not null and not context.customer.guest %}
    <div class="zanders-mobile-menu-footer">
        <div class="zanders-mobile-menu-quicklinks">
            <a href="{{ isCustomerLoggedIn ? path('frontend.account.home.page') : path('frontend.account.login.page') }}"
               class="zanders-mobile-menu-quicklink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span>{{ isCustomerLoggedIn ? ('account.myAccount'|trans|default('My Account')) : ('zanders.accountPage.loginButton'|trans|default('Login')) }}</span>
            </a>

            {% if config('core.cart.wishlistEnabled') and isCustomerLoggedIn %}
                <a href="{{ path('frontend.wishlist.page') }}"
                   class="zanders-mobile-menu-quicklink">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                    <span>{{ 'header.wishlist'|trans|default('My Wishlist') }}</span>
                </a>
            {% endif %}
        </div>

        <div class="zanders-mobile-menu-contact">
            <a href="tel:8008514373" class="zanders-mobile-menu-phone">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>{{ 'zanders.topBar.phone'|trans|default('800.851.4373') }}</span>
            </a>
            <span class="zanders-mobile-menu-hours">
                {{ 'zanders.topBar.hoursDays'|trans|default('Mon - Fri') }} {{ 'zanders.topBar.hoursTime'|trans|default('8:00AM To 4:30PM CST') }}
            </span>
        </div>
    </div>
{% endblock %}

