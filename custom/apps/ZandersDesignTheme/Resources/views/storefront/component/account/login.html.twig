{% block component_account_login %}
    <div class="zanders-login-box">
        {% block component_account_login_header %}
            <div class="text-center">
                <h2 class="zanders-registered-title text-uppercase fw-bold mb-2">
                    {{ 'zanders.accountPage.registeredCustomersTitle'|trans|default('REGISTERED CUSTOMERS') }}
                </h2>
                <div class="zanders-title-underline-dark mb-3 mx-auto"></div>

                <p class="zanders-registered-subtitle text-muted mb-4">
                    {{ 'zanders.accountPage.registeredCustomersSubtitle'|trans|default('If you have an account, sign in with your email address.') }}
                </p>
            </div>
        {% endblock %}

        {% block component_account_login_form %}
            <form class="login-form"
                  action="{{ path('frontend.account.login') }}"
                  method="post"
                  data-form-handler="true">
                {% block component_account_login_form_redirect %}
                    <input type="hidden"
                           name="redirectTo"
                           value="{{ redirectTo }}">

                    <input type="hidden"
                           name="redirectParameters"
                           value="{{ redirectParameters is iterable ? redirectParameters|json_encode : redirectParameters }}">
                {% endblock %}

                {% block component_account_login_form_error %}
                    {% if loginError %}
                        <div class="mb-3">
                            {% if errorSnippet != null %}
                                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                    type: 'danger',
                                    content: errorSnippet|trans|sw_sanitize({}, true),
                                    announceOnLoad: true,
                                    ariaLive: 'assertive'
                                } %}
                            {% elseif waitTime != null %}
                                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                    type: 'info',
                                    content: 'account.loginThrottled'|trans({'%seconds%': waitTime|number_format})|sw_sanitize,
                                    announceOnLoad: true
                                } %}
                            {% else %}
                                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                    type: 'danger',
                                    content: 'account.loginBadCredentials'|trans|sw_sanitize,
                                    announceOnLoad: true,
                                    ariaLive: 'assertive'
                                } %}
                            {% endif %}
                        </div>
                    {% endif %}
                {% endblock %}

                {% block component_account_login_form_fields %}
                    {# Email Address #}
                    <div class="mb-3">
                        <label for="loginMail" class="form-label zanders-form-label">
                            {{ 'account.loginMailLabel'|trans|default('Email Address') }} <span class="text-danger">*</span>
                        </label>
                        <input type="email"
                               class="form-control zanders-form-input{% if loginError %} is-invalid{% endif %}"
                               id="loginMail"
                               name="username"
                               placeholder="{{ 'account.loginMailLabel'|trans|default('Email Address') }}"
                               autocomplete="username webauthn"
                               required="required" />
                    </div>

                    {# Password with show/hide toggle #}
                    <div class="mb-3">
                        <label for="loginPassword" class="form-label zanders-form-label">
                            {{ 'account.loginPasswordLabel'|trans|default('Password') }} <span class="text-danger">*</span>
                        </label>
                        <div class="input-group zanders-password-input-group">
                            <input type="password"
                                   class="form-control zanders-form-input{% if loginError %} is-invalid{% endif %}"
                                   id="loginPassword"
                                   name="password"
                                   placeholder="{{ 'account.loginPasswordLabel'|trans|default('Password') }}"
                                   autocomplete="current-password"
                                   required="required" />
                            <button type="button"
                                    class="btn zanders-password-toggle-btn js-zanders-password-toggle"
                                    aria-label="Show or hide password"
                                    title="Toggle password visibility">
                                <svg class="zanders-eye-icon zanders-eye-show" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                                    <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                                </svg>
                                <svg class="zanders-eye-icon zanders-eye-hide d-none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"/>
                                    <path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    {# Remember Me Checkbox with Tooltip #}
                    <div class="form-check zanders-form-check mb-2">
                        <input type="checkbox"
                               class="form-check-input zanders-check-input"
                               id="loginRememberMe"
                               name="remember_me"
                               checked="checked" />
                        <label class="form-check-label zanders-check-label" for="loginRememberMe">
                            <span>{{ 'zanders.accountPage.rememberMe'|trans|default('Remember Me') }}</span>
                            <span class="zanders-tooltip-wrap">
                                <span class="zanders-tooltip-trigger" tabindex="0" role="button" aria-describedby="rememberTooltip">{{ 'zanders.accountPage.whatsThis'|trans|default("What's this?") }}</span>
                                <span class="zanders-tooltip-bubble" id="rememberTooltip" role="tooltip">
                                    {{ 'zanders.accountPage.rememberMeTooltip'|trans|default('Check "Remember Me" to access your shopping cart on this computer even if you are not signed in.') }}
                                </span>
                            </span>
                        </label>
                    </div>

                    {# Required Fields Note #}
                    <div class="zanders-required-note text-muted small mb-4">
                        {{ 'zanders.accountPage.requiredFields'|trans|default('* Required Fields') }}
                    </div>
                {% endblock %}

                {# Submit Button & Recover Password #}
                {% block component_account_login_submit %}
                    <div class="text-center d-flex flex-column align-items-center gap-3">
                        <button type="submit"
                                class="btn btn-primary zanders-btn-login">
                            <span>{{ 'zanders.accountPage.loginButton'|trans|default('LOGIN') }}</span>
                        </button>

                        {% block component_account_login_password_recover %}
                            <div class="login-password-recover">
                                <a href="{{ seoUrl('frontend.account.recover.page') }}"
                                   class="zanders-link-recover">
                                    {{ 'zanders.accountPage.forgotPassword'|trans|default('Forgot Your Password?') }}
                                </a>
                            </div>
                        {% endblock %}
                    </div>
                {% endblock %}
            </form>
        {% endblock %}
    </div>

    <script>
        (function () {
            function initLoginFeatures() {
                var toggleBtns = document.querySelectorAll('.js-zanders-password-toggle');
                toggleBtns.forEach(function (btn) {
                    if (btn.dataset.initialized) return;
                    btn.dataset.initialized = 'true';
                    btn.addEventListener('click', function () {
                        var group = btn.closest('.zanders-password-input-group');
                        if (!group) return;
                        var input = group.querySelector('input');
                        if (!input) return;
                        var isPassword = input.getAttribute('type') === 'password';
                        input.setAttribute('type', isPassword ? 'text' : 'password');
                        var showIcon = btn.querySelector('.zanders-eye-show');
                        var hideIcon = btn.querySelector('.zanders-eye-hide');
                        if (showIcon && hideIcon) {
                            showIcon.classList.toggle('d-none', isPassword);
                            hideIcon.classList.toggle('d-none', !isPassword);
                        }
                    });
                });
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initLoginFeatures);
            } else {
                initLoginFeatures();
            }
        })();
    </script>
{% endblock %}
