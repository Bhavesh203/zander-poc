{#
    Zanders Product Finder Component (Firearms Finder & Ammo Finder)
    Renders:
    1. Fixed left-edge vertical floating tabs ("Firearms Finder" in crimson red, "Ammo Finder" in gray)
    2. Slide-out left drawer with live cascading dropdown filters powered by `/widgets/zanders/finder/{type}`
    3. Per-field red "×" clear buttons, "No Match Found" disabled state, live "Matching Items" count,
       and "SEARCH" / "RESET ALL" action buttons
#}
{% block component_zanders_product_finder %}
    {# Fixed Left-Edge Vertical Floating Tabs #}
    <div class="zanders-finder-tabs" aria-label="Product Finders">
        <button type="button"
                class="zanders-finder-tab zanders-finder-tab--firearms js-zanders-finder-open"
                data-finder-type="firearms"
                aria-controls="zandersFinderDrawer"
                aria-expanded="false">
            <span class="zanders-finder-tab-icon" aria-hidden="true">
                {# Rifle silhouette SVG icon #}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.5 3.5V20.5M13.5 5.5H15.5V10.5H13.5M12 11.5H15V14.5H13.5V16.5L11 19.5V21H14.5V17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12.2 3H14.2V12.5H12.2V3Z" fill="currentColor"/>
                    <path d="M10.5 15.5L13.8 14.5V21H10.5V15.5Z" fill="currentColor"/>
                </svg>
            </span>
            <span class="zanders-finder-tab-label">Firearms Finder</span>
        </button>

        <button type="button"
                class="zanders-finder-tab zanders-finder-tab--ammo js-zanders-finder-open"
                data-finder-type="ammo"
                aria-controls="zandersFinderDrawer"
                aria-expanded="false">
            <span class="zanders-finder-tab-icon" aria-hidden="true">
                {# Ammo box / cartridge SVG icon #}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="4" width="16" height="16" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M9.5 16V10.8C9.5 9.2 10.6 7.5 12 7.5C13.4 7.5 14.5 9.2 14.5 10.8V16H9.5Z" fill="currentColor"/>
                    <line x1="7" y1="16.5" x2="17" y2="16.5" stroke="currentColor" stroke-width="1.4"/>
                </svg>
            </span>
            <span class="zanders-finder-tab-label">Ammo Finder</span>
        </button>
    </div>

    {# Dark Backdrop Overlay #}
    <div class="zanders-finder-backdrop js-zanders-finder-backdrop" aria-hidden="true"></div>

    {# Slide-Out Left Finder Drawer #}
    <aside id="zandersFinderDrawer"
           class="zanders-finder-drawer"
           role="dialog"
           aria-modal="true"
           aria-labelledby="zandersFinderTitle"
           aria-hidden="true"
           data-endpoint-base="{{ path('widgets.zanders.finder', { type: 'firearms' })|replace({'/firearms': ''}) }}">
        <div class="zanders-finder-header">
            <h2 id="zandersFinderTitle" class="zanders-finder-title js-zanders-finder-title">Firearms Finder</h2>
            <button type="button"
                    class="zanders-finder-close js-zanders-finder-close"
                    aria-label="Close Finder">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

        <div class="zanders-finder-body">
            {# Loading indicator shown while fetching live aggregations #}
            <div class="zanders-finder-loader js-zanders-finder-loader d-none" aria-live="polite">
                <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <span>Loading options...</span>
            </div>

            {# Dynamic dropdown select rows injected here by JS #}
            <div class="zanders-finder-fields js-zanders-finder-fields"></div>

            {# Live matching products count #}
            <div class="zanders-finder-count js-zanders-finder-count">
                Matching Items: <span class="js-zanders-finder-count-value">0</span>
            </div>

            {# Action Buttons: SEARCH & RESET ALL #}
            <div class="zanders-finder-actions">
                <button type="button" class="btn zanders-finder-btn js-zanders-finder-search">SEARCH</button>
                <button type="button" class="btn zanders-finder-btn js-zanders-finder-reset">RESET ALL</button>
            </div>
        </div>
    </aside>

    {#
        Product Finder Interactive Controller
        Handles:
        - Opening/closing the slide-out drawer for "firearms" or "ammo"
        - Fetching live cascading filter options & exact product counts from `/widgets/zanders/finder/{type}`
        - Rendering dropdown rows with per-field red "×" clear buttons & disabled "No Match Found" states
        - Navigating to the category listing URL with Shopware-compatible `manufacturer` & `properties` query params
    #}
    <script>
        (function () {
            var drawer = document.getElementById('zandersFinderDrawer');
            var backdrop = document.querySelector('.js-zanders-finder-backdrop');
            if (!drawer || !backdrop) return;

            var endpointBase = drawer.getAttribute('data-endpoint-base') || '/widgets/zanders/finder';
            var titleEl = drawer.querySelector('.js-zanders-finder-title');
            var fieldsEl = drawer.querySelector('.js-zanders-finder-fields');
            var loaderEl = drawer.querySelector('.js-zanders-finder-loader');
            var countValEl = drawer.querySelector('.js-zanders-finder-count-value');
            var searchBtn = drawer.querySelector('.js-zanders-finder-search');
            var resetBtn = drawer.querySelector('.js-zanders-finder-reset');
            var closeBtn = drawer.querySelector('.js-zanders-finder-close');
            var openBtns = document.querySelectorAll('.js-zanders-finder-open');

            // Active finder state stored separately per finder type ("firearms" / "ammo")
            var activeType = 'firearms';
            var categoryUrl = '/';
            var stateByType = {
                firearms: { manufacturer: '', properties: {} },
                ammo: { manufacturer: '', properties: {} }
            };

            /**
             * Returns the active filter state object (manufacturer & properties map) for the current finder type.
             * @returns {Object}
             */
            function getCurrentState() {
                if (!stateByType[activeType]) {
                    stateByType[activeType] = { manufacturer: '', properties: {} };
                }
                return stateByType[activeType];
            }

            /**
             * Builds a query string containing the currently selected manufacturer and property option IDs.
             * Format matches Shopware 6 Storefront listing URL parameters (`manufacturer` and pipe-joined `properties`).
             * @returns {string}
             */
            function buildFilterQueryString() {
                var state = getCurrentState();
                var params = new URLSearchParams();

                if (state.manufacturer) {
                    params.set('manufacturer', state.manufacturer);
                }

                var propIds = Object.values(state.properties).filter(Boolean);
                if (propIds.length > 0) {
                    params.set('properties', propIds.join('|'));
                }

                return params.toString();
            }

            /**
             * Toggles the loading overlay/spinner inside the drawer while AJAX options are fetched.
             * @param {boolean} isLoading
             */
            function setLoading(isLoading) {
                if (loaderEl) {
                    loaderEl.classList.toggle('d-none', !isLoading);
                }
                if (fieldsEl) {
                    fieldsEl.classList.toggle('is-loading', isLoading);
                }
            }

            /**
             * Builds a single filter dropdown row (select box + optional crimson "×" clear button).
             *
             * @param {Object} config
             * @param {string} config.fieldKey 'manufacturer' or property group ID
             * @param {string} config.label Display name of the filter (e.g. 'Manufacturer', 'CALIBER')
             * @param {string} config.selected Currently selected option UUID (empty string if unselected)
             * @param {Array<{id: string, name: string}>} config.options Available matching options
             * @param {boolean} config.isManufacturer True for manufacturer dropdown
             * @returns {HTMLElement}
             */
            function createFilterRow(config) {
                var row = document.createElement('div');
                row.className = 'zanders-finder-field-row';

                var select = document.createElement('select');
                select.className = 'form-select zanders-finder-select';
                select.setAttribute('aria-label', config.label);
                select.dataset.fieldKey = config.fieldKey;
                select.dataset.isManufacturer = config.isManufacturer ? '1' : '0';

                var hasOptions = Array.isArray(config.options) && config.options.length > 0;
                var placeholder = document.createElement('option');
                placeholder.value = '';

                if (!hasOptions && !config.selected) {
                    // Zero matching options for this filter: show disabled "No Match Found" state
                    placeholder.textContent = config.label.toUpperCase() + ': No Match Found';
                    select.appendChild(placeholder);
                    select.disabled = true;
                    select.classList.add('is-empty');
                } else {
                    var countLabel = config.options.length === 1 ? '1 option' : (config.options.length + ' options');
                    placeholder.textContent = 'Select ' + config.label + ' (' + countLabel + ')';
                    select.appendChild(placeholder);

                    config.options.forEach(function (opt) {
                        var optionEl = document.createElement('option');
                        optionEl.value = opt.id;
                        optionEl.textContent = opt.name;
                        if (config.selected && opt.id === config.selected) {
                            optionEl.selected = true;
                        }
                        select.appendChild(optionEl);
                    });

                    // Handle user selecting/changing a filter value
                    select.addEventListener('change', function () {
                        var state = getCurrentState();
                        if (config.isManufacturer) {
                            state.manufacturer = select.value;
                        } else {
                            if (select.value) {
                                state.properties[config.fieldKey] = select.value;
                            } else {
                                delete state.properties[config.fieldKey];
                            }
                        }
                        fetchFinderData();
                    });
                }

                row.appendChild(select);

                // Show crimson "×" clear button outside the right edge of the select when a value is selected
                if (config.selected) {
                    var clearBtn = document.createElement('button');
                    clearBtn.type = 'button';
                    clearBtn.className = 'zanders-finder-clear-btn';
                    clearBtn.setAttribute('aria-label', 'Clear ' + config.label);
                    clearBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 1.5L10.5 10.5M10.5 1.5L1.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';

                    clearBtn.addEventListener('click', function () {
                        var state = getCurrentState();
                        if (config.isManufacturer) {
                            state.manufacturer = '';
                        } else {
                            delete state.properties[config.fieldKey];
                        }
                        fetchFinderData();
                    });

                    row.appendChild(clearBtn);
                }

                return row;
            }

            /**
             * Renders the Manufacturer dropdown, all property group dropdowns, and the live Matching Items count.
             * @param {Object} data JSON payload returned by `/widgets/zanders/finder/{type}`
             */
            function renderFinderData(data) {
                if (titleEl && data.title) {
                    titleEl.textContent = data.title;
                }
                if (data.categoryUrl) {
                    categoryUrl = data.categoryUrl;
                }
                if (countValEl) {
                    countValEl.textContent = typeof data.total === 'number' ? data.total : 0;
                }

                if (!fieldsEl) return;
                fieldsEl.innerHTML = '';

                // 1. Manufacturer dropdown (always first)
                var mfg = data.manufacturer || { selected: '', options: [] };
                fieldsEl.appendChild(createFilterRow({
                    fieldKey: 'manufacturer',
                    label: 'Manufacturer',
                    selected: mfg.selected || '',
                    options: mfg.options || [],
                    isManufacturer: true
                }));

                // 2. Dynamic property group dropdowns
                var groups = Array.isArray(data.groups) ? data.groups : [];
                groups.forEach(function (group) {
                    fieldsEl.appendChild(createFilterRow({
                        fieldKey: group.id,
                        label: group.name,
                        selected: group.selected || '',
                        options: group.options || [],
                        isManufacturer: false
                    }));
                });
            }

            /**
             * Requests updated cascading filter options and matching product total from the server.
             */
            function fetchFinderData() {
                setLoading(true);
                var query = buildFilterQueryString();
                var url = endpointBase + '/' + encodeURIComponent(activeType) + (query ? ('?' + query) : '');

                fetch(url, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                })
                    .then(function (res) {
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        return res.json();
                    })
                    .then(function (data) {
                        if (data && data.success) {
                            renderFinderData(data);
                        }
                    })
                    .catch(function (err) {
                        console.error('[ZandersFinder] Failed to load options:', err);
                    })
                    .finally(function () {
                        setLoading(false);
                    });
            }

            /**
             * Opens the slide-out drawer for the given finder type ("firearms" or "ammo")
             * and loads live options from the backend.
             * @param {'firearms'|'ammo'} type
             */
            function openDrawer(type) {
                activeType = type === 'ammo' ? 'ammo' : 'firearms';
                if (titleEl) {
                    titleEl.textContent = activeType === 'ammo' ? 'Ammo Finder' : 'Firearms Finder';
                }

                drawer.classList.add('is-open');
                drawer.setAttribute('aria-hidden', 'false');
                backdrop.classList.add('is-open');
                backdrop.setAttribute('aria-hidden', 'false');
                document.body.classList.add('zanders-finder-open');

                openBtns.forEach(function (btn) {
                    var isMatch = btn.getAttribute('data-finder-type') === activeType;
                    btn.setAttribute('aria-expanded', isMatch ? 'true' : 'false');
                });

                fetchFinderData();
            }

            /**
             * Closes the slide-out finder drawer and restores page scrolling.
             */
            function closeDrawer() {
                drawer.classList.remove('is-open');
                drawer.setAttribute('aria-hidden', 'true');
                backdrop.classList.remove('is-open');
                backdrop.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('zanders-finder-open');

                openBtns.forEach(function (btn) {
                    btn.setAttribute('aria-expanded', 'false');
                });
            }

            // Attach click handlers to both floating left-edge tabs
            openBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var type = btn.getAttribute('data-finder-type') || 'firearms';
                    openDrawer(type);
                });
            });

            // Close drawer on "×" button click, backdrop click, or Escape key
            if (closeBtn) {
                closeBtn.addEventListener('click', closeDrawer);
            }
            backdrop.addEventListener('click', closeDrawer);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
                    closeDrawer();
                }
            });

            // SEARCH button: navigate to Firearms/Ammunition category page with selected filters applied
            if (searchBtn) {
                searchBtn.addEventListener('click', function () {
                    var query = buildFilterQueryString();
                    var separator = categoryUrl.indexOf('?') === -1 ? '?' : '&';
                    window.location.href = query ? (categoryUrl + separator + query) : categoryUrl;
                });
            }

            // RESET ALL button: clear all selections for the active finder and reload live counts
            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    stateByType[activeType] = { manufacturer: '', properties: {} };
                    fetchFinderData();
                });
            }
        })();
    </script>
{% endblock %}
