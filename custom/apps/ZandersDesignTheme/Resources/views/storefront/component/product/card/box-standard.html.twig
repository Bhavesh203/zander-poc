{% sw_extends '@Storefront/storefront/component/product/card/box-standard.html.twig' %}

{% block component_product_box_badges %}
{# Badges hidden for clean card design matching reference #}
{% endblock %}

{% block component_product_box_image %}
<div class="product-image-wrapper">
    <a href="{{ seoUrl('frontend.detail.page', routeArguments) }}" title="{{ name }}"
        class="product-image-link is-contain">
        {% if cover.url and cover.isSpatialObject() == false %}
        {% set attributes = {
        class: 'product-image is-contain',
        alt: (cover.translated.alt ?: name),
        title: (cover.translated.title ?: name),
        loading: 'lazy'
        } %}
        {% sw_thumbnails 'product-image-thumbnails' with {
        media: cover,
        sizes: sizes,
        attributes: attributes
        } %}
        {% else %}
        <div class="product-image-placeholder">
            {% sw_icon 'placeholder' style {
            size: 'fluid'
            } %}
        </div>
        {% endif %}
    </a>
</div>
{% endblock %}

{% block component_product_box_rating %}
{# Rating hidden #}
{% endblock %}

{% block component_product_box_name %}
<a href="{{ seoUrl('frontend.detail.page', routeArguments) }}" title="{{ name }}" class="product-name">
    {{ name }}
</a>
{% endblock %}

{% block component_product_box_variant_characteristics %}
{# Variant characteristics hidden #}
{% endblock %}

{% block component_product_box_description %}
{# Description hidden #}
{% endblock %}

{% block component_product_box_price %}
<div class="product-card-meta">
    {% if sku %}
    <div class="product-card-meta-item">
        <span class="meta-label">{{ 'zanders.productCard.itemNumber'|trans }}:</span>
        <span class="meta-value">{{ sku }}</span>
    </div>
    {% endif %}

    {% set upcVal = product.translated.customFields.upc ?: (product.customFields.upc ?: product.ean) %}
    {% if upcVal %}
    <div class="product-card-meta-item">
        <span class="meta-label">{{ 'zanders.productCard.upc'|trans }}:</span>
        <span class="meta-value">{{ upcVal }}</span>
    </div>
    {% endif %}

    <div class="product-card-meta-item">
        <span class="meta-label">{{ 'zanders.productCard.available'|trans }}:</span>
        {% set availableStock = product.availableStock %}
        {% set stock = product.stock %}
        {% if availableStock is not null and availableStock > 0 %}
        <span class="meta-value">{{ availableStock }}</span>
        {% elseif stock is not null and stock > 0 %}
        <span class="meta-value">{{ stock }}</span>
        {% elseif product.available and not product.isCloseout %}
        <span class="meta-value">{{ 'zanders.productCard.inStock'|trans }}</span>
        {% else %}
        <span class="meta-value text-muted">{{ 'zanders.productCard.outOfStock'|trans }}</span>
        {% endif %}
    </div>
</div>

<div class="product-card-price-primary">
    {% set price = product.calculatedPrice %}
    {% if product.calculatedPrices.count > 0 %}
    {% set price = product.calculatedPrices.last %}
    {% endif %}
    {% if product.variantListingConfig.displayParent and product.parentId === null %}
    {% set price = product.calculatedCheapestPrice %}
    {% endif %}

    <span class="primary-price-value">{{ price.unitPrice|currency }}</span>
</div>
{% endblock %}

{% block component_product_box_action %}
{% set isAvailable = not product.isCloseout or (product.stock >= product.minPurchase) %}
{% set displayFrom = product.calculatedPrices.count > 1 %}
{% set displayBuyButton = isAvailable and not displayFrom and product.childCount <= 0 %} {% set
    detailUrl=seoUrl('frontend.detail.page', routeArguments) %} {% set price=product.calculatedPrice %} {% if
    product.calculatedPrices.count> 0 %}
    {% set price = product.calculatedPrices.last %}
    {% endif %}
    {% if product.variantListingConfig.displayParent and product.parentId === null %}
    {% set price = product.calculatedCheapestPrice %}
    {% endif %}

    {% set msrpVal = (price.listPrice ? price.listPrice.price : null) %}
    {% if not msrpVal and (product.translated.customFields.msrp or product.customFields.msrp) %}
    {% set msrpVal = product.translated.customFields.msrp ?: product.customFields.msrp %}
    {% endif %}
    {% if not msrpVal %}
    {% set msrpVal = price.unitPrice %}
    {% endif %}

    {% set mapVal = product.translated.customFields.map ?: (product.customFields.map ?: null) %}
    {% if not mapVal %}
    {% set mapVal = msrpVal %}
    {% endif %}

    <div class="product-action-wrapper">
        <form action="{{ path('frontend.checkout.line-item.add') }}" method="post" class="buy-widget product-card-form"
            data-add-to-cart="true">

            <input type="hidden" name="redirectTo" value="frontend.cart.offcanvas" class="js-redirect-to">
            <input type="hidden" name="redirectParameters" data-redirect-parameters="true"
                value="{{ {productId: id}|json_encode }}">
            <input type="hidden" name="lineItems[{{ id }}][id]" value="{{ id }}">
            <input type="hidden" name="lineItems[{{ id }}][referencedId]" value="{{ id }}">
            <input type="hidden" name="lineItems[{{ id }}][type]" value="product">
            <input type="hidden" name="lineItems[{{ id }}][stackable]" value="1">
            <input type="hidden" name="lineItems[{{ id }}][removable]" value="1">
            <input type="hidden" name="product-name" value="{{ name }}">

            {# Quantity Selector: Qty: [ 00 ] #}
            <div class="product-card-qty-row">
                <label for="qty-{{ id }}" class="product-card-qty-label">{{ 'zanders.productCard.qty'|trans }}:</label>
                <input type="number" id="qty-{{ id }}" name="lineItems[{{ id }}][quantity]"
                    value="{{ product.minPurchase ?: 1 }}" min="{{ product.minPurchase ?: 1 }}"
                    max="{{ product.maxPurchase ?: (product.availableStock ?: 100) }}"
                    step="{{ product.purchaseSteps ?: 1 }}" class="form-control product-card-qty-input" />
            </div>

            {# Secondary Prices: MSRP : $899.00 and MAP : $899.00 #}
            <div class="product-card-secondary-prices">
                <div class="price-col msrp-col">
                    <span class="price-label">{{ 'zanders.productCard.msrp'|trans }} :</span>
                    <span class="price-val">{{ msrpVal|currency }}</span>
                </div>
                <div class="price-col map-col">
                    <span class="price-label">{{ 'zanders.productCard.map'|trans }} :</span>
                    <span class="price-val">{{ mapVal|currency }}</span>
                </div>
            </div>

            {# Circular Action Icons Row (Wishlist [logged-in only], Compare, Quick View) #}
            <div class="product-card-action-icons">
                {# Wishlist (shown only when customer is logged in) #}
                {% set isCustomerLoggedIn = context.customer is not null and not context.customer.guest %}
                {% if config('core.cart.wishlistEnabled') and isCustomerLoggedIn %}
                    {% set addToWishlistOptions = {
                    productId: id,
                    router: {
                    add: {
                    afterLoginPath: path('frontend.wishlist.add.after.login', { productId: id }),
                    path: path('frontend.wishlist.product.add', { productId: id }),
                    },
                    remove: {
                    path: path('frontend.wishlist.product.remove', { productId: id }),
                    }
                    },
                    texts: {
                    add: 'listing.addToWishlist'|trans|sw_sanitize,
                    remove: 'listing.removeFromWishlist'|trans|sw_sanitize
                    },
                    } %}
                    <button type="button"
                        class="product-card-icon-btn product-wishlist-btn product-wishlist-{{ id }} product-wishlist-not-added"
                        title="{{ 'listing.addToWishlist'|trans|sw_sanitize }}" data-add-to-wishlist="true"
                        data-product-id="{{ id }}" data-add-to-wishlist-options="{{ addToWishlistOptions|json_encode }}">
                        <span class="icon-wishlist-not-added">

                            <svg class="icon icon-heart" width="24" height="24" viewBox="0 0 24 24" fill="#A1A1A1"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M16.44 3.10001C14.63 3.10001 13.01 3.98001 12 5.33001C10.99 3.98001 9.37 3.10001 7.56 3.10001C4.49 3.10001 2 5.60001 2 8.69001C2 9.88001 2.19 10.98 2.52 12C4.1 17 8.97 19.99 11.38 20.81C11.72 20.93 12.28 20.93 12.62 20.81C15.03 19.99 19.9 17 21.48 12C21.81 10.98 22 9.88001 22 8.69001C22 5.60001 19.51 3.10001 16.44 3.10001Z"
                                    fill="#A1A1A1" />
                            </svg>

                        </span>
                        <span class="icon-wishlist-added">
                            <svg class="icon icon-heart-fill" width="24" height="24" viewBox="0 0 24 24" fill="#8c1d2f"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M16.44 3.10001C14.63 3.10001 13.01 3.98001 12 5.33001C10.99 3.98001 9.37 3.10001 7.56 3.10001C4.49 3.10001 2 5.60001 2 8.69001C2 9.88001 2.19 10.98 2.52 12C4.1 17 8.97 19.99 11.38 20.81C11.72 20.93 12.28 20.93 12.62 20.81C15.03 19.99 19.9 17 21.48 12C21.81 10.98 22 9.88001 22 8.69001C22 5.60001 19.51 3.10001 16.44 3.10001Z"
                                    fill="#8c1d2f" />
                            </svg>
                        </span>
                    </button>
                {% endif %}

                {# Compare (wired to FroshProductCompare plugin) #}
                {% if config('FroshProductCompare.config.active') %}
                    {% set addToCompareOptions = {
                        productId: id,
                        showIconOnly: true,
                        defaultText: 'froshProductCompare.general.addToCompare'|trans|sw_sanitize,
                        addedText: 'froshProductCompare.general.removeFromCompare'|trans|sw_sanitize
                    } %}
                    <button type="button"
                        class="product-card-icon-btn product-compare-btn"
                        data-add-to-compare-button="true"
                        data-add-to-compare-button-options="{{ addToCompareOptions|json_encode }}"
                        title="{{ 'zanders.productCard.compare'|trans }}">
                        <svg class="icon icon-scale" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                            <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                            <path d="M7 21h10" />
                            <path d="M12 3v18" />
                            <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
                        </svg>
                    </button>
                {% endif %}

                {# Quick View #}
                <button type="button" data-url="{{ path('widgets.quickview.minimal', { productId: id }) }}"
                    data-product-id="{{ id }}" data-ajax-modal="true" data-modal-class="quickview-modal"
                    class="product-card-icon-btn product-quickview-btn"
                    title="{{ 'zanders.productCard.quickView'|trans }}">
                    <svg class="icon icon-eye" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>

            {# Action Buttons: ADD TO CART & BUY NOW #}
            <div class="product-card-action-buttons">
                {% if displayBuyButton and config('core.listing.allowBuyInListing') %}
                <button type="submit" name="redirectTo" value="frontend.cart.offcanvas"
                    class="btn btn-primary product-card-btn-add">
                    {{ 'zanders.productCard.addToCart'|trans }}
                </button>
                <button type="button" class="btn btn-primary product-card-btn-buy"
                    onclick="var f=this.closest('form'); if(f){ var r=f.querySelector('input[name=redirectTo]'); if(r) r.value='frontend.checkout.confirm.page'; HTMLFormElement.prototype.submit.call(f); }">
                    {{ 'zanders.productCard.buyNow'|trans }}
                </button>
                {% else %}
                <a href="{{ detailUrl }}" class="btn btn-primary product-card-btn-add">
                    {{ 'zanders.productCard.addToCart'|trans }}
                </a>
                <a href="{{ detailUrl }}" class="btn btn-primary product-card-btn-buy">
                    {{ 'zanders.productCard.buyNow'|trans }}
                </a>
                {% endif %}
            </div>
        </form>
    </div>
    {% endblock %}