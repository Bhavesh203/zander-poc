{% sw_extends '@Storefront/storefront/component/product/quickview/minimal.html.twig' %}

{% block component_product_quickview_minimal %}
{% set isStandalone = not app.request.xmlHttpRequest %}
{% set product = page.product %}
{% set name = product.translated.name %}
{% set manufacturer = product.manufacturer %}
{% set id = product.id %}
{% set sku = product.productNumber %}
{% set detailUrl = seoUrl('frontend.detail.page', { productId: id }) %}

{% set price = product.calculatedPrice %}
{% if product.calculatedPrices.count > 0 %}
{% set price = product.calculatedPrices.last %}
{% endif %}
{% if product.variantListingConfig.displayParent and product.parentId === null %}
{% set price = product.calculatedCheapestPrice %}
{% endif %}

{% set msrpVal = (price.listPrice ? price.listPrice.price : null) %}
{% if not msrpVal and (product.translated.customFields.msrp or product.customFields.msrp) %}
{% set msrpVal = product.translated.customFields.msrp ?: product.customFields.msrp %}
{% endif %}
{% if not msrpVal %}
{% set msrpVal = price.unitPrice %}
{% endif %}

{% set mapVal = product.translated.customFields.map ?: (product.customFields.map ?: null) %}
{% if not mapVal %}
{% set mapVal = msrpVal %}
{% endif %}

{% set isAvailable = not product.isCloseout or (product.stock >= product.minPurchase) %}
{% set displayBuyButton = isAvailable and product.childCount <= 0 %} {% if isStandalone %} <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ name }} | {{ 'zanders.productCard.quickView'|trans|default('Quick View') }}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
            rel="stylesheet">
        {% set assets = theme_config('assets.css') ?? [] %}
        {% for file in assets %}
        <link rel="stylesheet" href="{{ asset(file, 'theme') }}">
        {% endfor %}
        <style>
            body {
                background-color: #f2f4f7;
                font-family: 'Poppins', sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px 16px;
                margin: 0;
            }

            .standalone-quickview-frame {
                max-width: 860px;
                width: 100%;
                background: #ffffff;
                border-radius: 4px;
                box-shadow: 0 12px 48px rgba(0, 0, 0, 0.15);
                overflow: hidden;
            }

            .standalone-quickview-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 24px;
                border-bottom: 1px solid #f0f0f0;
                background: #ffffff;
            }

            .standalone-quickview-body {
                padding: 24px 28px 28px;
            }
        </style>
    </head>

    <body>
        <div class="standalone-quickview-frame quickview-modal">
            <div class="standalone-quickview-header">
                <span class="quickview-modal-header-badge">{{ 'zanders.productCard.quickView'|trans|default('Quick
                    View') }}</span>
                <a href="{{ detailUrl }}" class="btn-close" aria-label="Close"></a>
            </div>
            <div class="standalone-quickview-body">
                {% endif %}

                <div class="js-pseudo-modal-template-title-element d-none">
                    <span class="quickview-modal-header-badge">{{ 'zanders.productCard.quickView'|trans|default('Quick
                        View') }}</span>
                </div>

                <div class="zanders-quickview-container" data-product-id="{{ id }}">
                    {# Quick View Top Row: Image & Details #}
                    <div class="row g-4 align-items-start">
                        {# Left Column: Gallery / Product Media #}
                        <div class="col-12 col-md-6 quickview-media-col">
                            <div class="quickview-main-image-wrapper">
                                {% if product.cover.media %}
                                <img src="{{ product.cover.media.url }}"
                                    alt="{{ product.cover.translated.alt ?: name }}" class="quickview-main-image"
                                    id="qv-main-image-{{ id }}" />
                                {% else %}
                                <div class="quickview-placeholder">
                                    {% sw_icon 'placeholder' style { size: 'fluid' } %}
                                </div>
                                {% endif %}
                            </div>

                            {# Thumbnail gallery if product has multiple images #}
                            {% if product.media and product.media.count > 1 %}
                            <div class="quickview-thumbnails-row">
                                {% for mediaItem in product.media %}
                                <button type="button" class="qv-thumb-btn{% if loop.first %} is-active{% endif %}"
                                    onclick="var m=document.getElementById('qv-main-image-{{ id }}'); if(m){ m.src='{{ mediaItem.media.url }}'; var b=this.parentElement.querySelectorAll('.qv-thumb-btn'); b.forEach(function(el){ el.classList.remove('is-active'); }); this.classList.add('is-active'); }">
                                    <img src="{{ mediaItem.media.url }}" alt="{{ name }}" />
                                </button>
                                {% endfor %}
                            </div>
                            {% endif %}
                        </div>

                        {# Right Column: Product Information & Purchase Action #}
                        <div class="col-12 col-md-6 quickview-details-col">
                            {% if manufacturer %}
                            <div class="quickview-brand">
                                {{ manufacturer.translated.name }}
                            </div>
                            {% endif %}

                            <h3 class="quickview-title">
                                <a href="{{ detailUrl }}" title="{{ name }}">
                                    {{ name }}
                                </a>
                            </h3>

                            {# Metadata Block (matching product card style) #}
                            <div class="quickview-meta">
                                {% if sku %}
                                <div class="quickview-meta-row">
                                    <span class="meta-label">{{ 'zanders.productCard.itemNumber'|trans }}:</span>
                                    <span class="meta-val">{{ sku }}</span>
                                </div>
                                {% endif %}

                                {% set upcVal = product.translated.customFields.upc ?: (product.customFields.upc ?: product.ean) %}
                                {% if upcVal %}
                                <div class="quickview-meta-row">
                                    <span class="meta-label">{{ 'zanders.productCard.upc'|trans }}:</span>
                                    <span class="meta-val">{{ upcVal }}</span>
                                </div>
                                {% endif %}

                                <div class="quickview-meta-row">
                                    <span class="meta-label">{{ 'zanders.productCard.available'|trans }}:</span>
                                    {% set availableStock = product.availableStock %}
                                    {% set stock = product.stock %}
                                    {% if availableStock is not null and availableStock > 0 %}
                                    <span class="meta-val stock-in">{{ availableStock }}</span>
                                    {% elseif stock is not null and stock > 0 %}
                                    <span class="meta-val stock-in">{{ stock }}</span>
                                    {% elseif product.available and not product.isCloseout %}
                                    <span class="meta-val stock-in">{{ 'zanders.productCard.inStock'|trans }}</span>
                                    {% else %}
                                    <span class="meta-val stock-out">{{ 'zanders.productCard.outOfStock'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            {# Price Section #}
                            <div class="quickview-price-section">
                                <div class="quickview-price-primary">
                                    {{ price.unitPrice|currency }}
                                </div>

                                <div class="quickview-price-secondary">
                                    <span class="price-item">
                                        <span class="price-lbl">{{ 'zanders.productCard.msrp'|trans }} :</span>
                                        <span class="price-amt">{{ msrpVal|currency }}</span>
                                    </span>
                                    <span class="price-item">
                                        <span class="price-lbl">{{ 'zanders.productCard.map'|trans }} :</span>
                                        <span class="price-amt">{{ mapVal|currency }}</span>
                                    </span>
                                </div>
                            </div>

                            {# Short Description summary #}
                            {% if product.translated.description %}
                            <div class="quickview-short-desc">
                                {{ product.translated.description|striptags|slice(0, 180) }}...
                            </div>
                            {% endif %}

                            {# Buy & Quantity Form #}
                            <form action="{{ path('frontend.checkout.line-item.add') }}" method="post"
                                class="buy-widget quickview-buy-form" data-add-to-cart="true">

                                <input type="hidden" name="redirectTo" value="frontend.cart.offcanvas">
                                <input type="hidden" name="redirectParameters" data-redirect-parameters="true"
                                    value="{{ {productId: id}|json_encode }}">
                                <input type="hidden" name="lineItems[{{ id }}][id]" value="{{ id }}">
                                <input type="hidden" name="lineItems[{{ id }}][referencedId]" value="{{ id }}">
                                <input type="hidden" name="lineItems[{{ id }}][type]" value="product">
                                <input type="hidden" name="lineItems[{{ id }}][stackable]" value="1">
                                <input type="hidden" name="lineItems[{{ id }}][removable]" value="1">
                                <input type="hidden" name="product-name" value="{{ name }}">

                                <div class="quickview-qty-row">
                                    <label for="qv-qty-{{ id }}" class="quickview-qty-label">{{
                                        'zanders.productCard.qty'|trans }}:</label>
                                    <div class="quickview-qty-control">
                                        <button type="button" class="qv-qty-btn qv-qty-minus"
                                            onclick="var i=document.getElementById('qv-qty-{{ id }}'); var v=parseInt(i.value,10)||1; if(v>1){ i.value=v-1; }">-</button>
                                        <input type="number" id="qv-qty-{{ id }}" name="lineItems[{{ id }}][quantity]"
                                            value="{{ product.minPurchase ?: 1 }}" min="{{ product.minPurchase ?: 1 }}"
                                            max="{{ product.maxPurchase ?: (product.availableStock ?: 100) }}"
                                            step="{{ product.purchaseSteps ?: 1 }}"
                                            class="form-control quickview-qty-input" />
                                        <button type="button" class="qv-qty-btn qv-qty-plus"
                                            onclick="var i=document.getElementById('qv-qty-{{ id }}'); var v=parseInt(i.value,10)||1; var max=parseInt(i.max,10)||100; if(v<max){ i.value=v+1; }">+</button>
                                    </div>
                                </div>

                                <div class="quickview-action-buttons">
                                    {% if displayBuyButton and config('core.listing.allowBuyInListing') %}
                                    <button type="submit" name="redirectTo" value="frontend.cart.offcanvas"
                                        class="btn btn-primary qv-btn-add">
                                        {{ 'zanders.productCard.addToCart'|trans }}
                                    </button>
                                    <button type="button" class="btn btn-primary qv-btn-buy"
                                        onclick="var f=this.closest('form'); if(f){ var r=f.querySelector('input[name=redirectTo]'); if(r) r.value='frontend.checkout.confirm.page'; HTMLFormElement.prototype.submit.call(f); }">
                                        {{ 'zanders.productCard.buyNow'|trans }}
                                    </button>
                                    {% else %}
                                    <a href="{{ detailUrl }}" class="btn btn-primary qv-btn-add">
                                        {{ 'zanders.productCard.addToCart'|trans }}
                                    </a>
                                    <a href="{{ detailUrl }}" class="btn btn-primary qv-btn-buy">
                                        {{ 'zanders.productCard.buyNow'|trans }}
                                    </a>
                                    {% endif %}
                                </div>
                            </form>

                            {# Secondary Actions: Wishlist (logged-in only) and Full Details link #}
                            <div class="quickview-secondary-actions">
                                {% set isCustomerLoggedIn = context.customer is not null and not context.customer.guest %}
                                {% if config('core.cart.wishlistEnabled') and isCustomerLoggedIn %}
                                    {% set addToWishlistOptions = {
                                    productId: id,
                                    router: {
                                    add: {
                                    afterLoginPath: path('frontend.wishlist.add.after.login', { productId: id }),
                                    path: path('frontend.wishlist.product.add', { productId: id }),
                                    },
                                    remove: {
                                    path: path('frontend.wishlist.product.remove', { productId: id }),
                                    }
                                    },
                                    texts: {
                                    add: 'listing.addToWishlist'|trans|sw_sanitize,
                                    remove: 'listing.removeFromWishlist'|trans|sw_sanitize
                                    },
                                    } %}
                                    <button type="button"
                                        class="qv-wishlist-action-btn product-wishlist-btn product-wishlist-{{ id }} product-wishlist-not-added"
                                        data-add-to-wishlist="true" data-product-id="{{ id }}"
                                        data-add-to-wishlist-options="{{ addToWishlistOptions|json_encode }}">
                                        <span class="icon-wishlist-not-added">
                                            <svg class="icon icon-heart" width="24" height="24" viewBox="0 0 24 24"
                                                fill="#A1A1A1" xmlns="http://www.w3.org/2000/svg">
                                                <path
                                                    d="M16.44 3.10001C14.63 3.10001 13.01 3.98001 12 5.33001C10.99 3.98001 9.37 3.10001 7.56 3.10001C4.49 3.10001 2 5.60001 2 8.69001C2 9.88001 2.19 10.98 2.52 12C4.1 17 8.97 19.99 11.38 20.81C11.72 20.93 12.28 20.93 12.62 20.81C15.03 19.99 19.9 17 21.48 12C21.81 10.98 22 9.88001 22 8.69001C22 5.60001 19.51 3.10001 16.44 3.10001Z"
                                                    fill="#A1A1A1" />
                                            </svg>
                                        </span>
                                        <span class="icon-wishlist-added">
                                            <svg class="icon icon-heart-fill" width="24" height="24" viewBox="0 0 24 24"
                                                fill="#8c1d2f" xmlns="http://www.w3.org/2000/svg">
                                                <path
                                                    d="M16.44 3.10001C14.63 3.10001 13.01 3.98001 12 5.33001C10.99 3.98001 9.37 3.10001 7.56 3.10001C4.49 3.10001 2 5.60001 2 8.69001C2 9.88001 2.19 10.98 2.52 12C4.1 17 8.97 19.99 11.38 20.81C11.72 20.93 12.28 20.93 12.62 20.81C15.03 19.99 19.9 17 21.48 12C21.81 10.98 22 9.88001 22 8.69001C22 5.60001 19.51 3.10001 16.44 3.10001Z"
                                                    fill="#8c1d2f" />
                                            </svg>
                                        </span>
                                        <span class="qv-wishlist-text">{{ 'listing.addToWishlist'|trans|sw_sanitize
                                            }}</span>
                                    </button>
                                {% endif %}

                                <a href="{{ detailUrl }}" class="qv-view-detail-link">
                                    {{ 'listing.boxProductDetails'|trans|default('View Full Details') }} &rarr;
                                </a>
                            </div>
                        </div>
                    </div>

                    {# Specifications Section (if properties exist) #}
                    {% if product.properties and product.properties.count > 0 %}
                    <div class="quickview-properties-section mt-4 pt-3 border-top">
                        <h5 class="quickview-section-heading">Specifications</h5>
                        <div class="row row-cols-1 row-cols-sm-2 g-2 quickview-properties-grid">
                            {% for property in product.properties %}
                            <div class="col">
                                <div class="qv-prop-item">
                                    <span class="qv-prop-label">{{ property.group.translated.name }}:</span>
                                    <span class="qv-prop-val">{{ property.translated.name }}</span>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </div>

                {% if isStandalone %}
            </div>
        </div>
    </body>

    </html>
    {% endif %}
    {% endblock %}